{{template "shared/start" .}}
<div class="hg-landing">
<section class="hg-landing-hero" aria-labelledby="landing-title">
<div><p class="hg-landing-eyebrow">{{.i18n.Tr "ui.landing_meet"}}</p><h1 id="landing-title">{{.i18n.Tr "ui.landing_tagline"}}</h1><p class="hg-landing-lead">{{.i18n.Tr "ui.landing_lead"}}</p>
<div class="hg-actions">{{if .ShowPublicExplore}}<a class="hg-button hg-button-primary" href="{{AppSubUrl}}/explore?visibility=public">{{.i18n.Tr "ui.explore_repositories"}} <span aria-hidden="true">→</span></a>{{end}}<a class="hg-button" href="{{AppSubUrl}}/user/login">{{.i18n.Tr "sign_in"}}</a>{{if .ShowRegistrationButton}}<a class="hg-button" href="{{AppSubUrl}}/user/sign_up">{{.i18n.Tr "sign_up"}}</a>{{end}}</div>
{{if .OauthEnabled}}<div class="hg-landing-providers" aria-label="{{.i18n.Tr "ui.sign_in_with"}}">{{template "shared/social" .}}</div>{{end}}
<p class="hg-meta">{{.i18n.Tr "ui.landing_note"}}</p></div>
<figure class="hg-landing-mascot"><img src="{{AppSubUrl}}/img/hgs-mascot.png" width="1218" height="1292" alt="{{.i18n.Tr "ui.mascot_alt"}}"><figcaption>{{.i18n.Tr "ui.landing_curiosity"}}</figcaption></figure>
</section>
<section class="hg-landing-intro" aria-labelledby="landing-intro"><h2 id="landing-intro">{{.i18n.Tr "ui.landing_intro_title"}}</h2><p>{{.i18n.Tr "ui.landing_intro"}}</p></section>
<section class="hg-landing-features" aria-label="{{.i18n.Tr "ui.landing_features"}}">
<article><span aria-hidden="true">01</span><h3>{{.i18n.Tr "ui.landing_source_title"}}</h3><p>{{.i18n.Tr "ui.landing_source"}}</p></article>
<article><span aria-hidden="true">02</span><h3>{{.i18n.Tr "ui.landing_discuss_title"}}</h3><p>{{.i18n.Tr "ui.landing_discuss"}}</p></article>
<article><span aria-hidden="true">03</span><h3>{{.i18n.Tr "ui.landing_workspace_title"}}</h3><p>{{.i18n.Tr "ui.landing_workspace"}}</p></article>
</section>
{{if .ShowPublicExplore}}
{{if .LandingCloneCommand}}<section class="hg-landing-workflow" data-landing-clone aria-labelledby="landing-workflow"><div><p class="hg-landing-eyebrow">{{.i18n.Tr "ui.landing_terminal"}}</p><h2 id="landing-workflow">{{.i18n.Tr "ui.landing_clone_title"}}</h2><p>{{.i18n.Tr "ui.landing_clone"}}</p></div><div class="hg-landing-command" data-repository-controls><label for="landing-clone">{{.i18n.Tr "ui.clone"}}</label><input id="landing-clone" readonly data-clone-value value="{{.LandingCloneCommand}}"><button class="hg-button" type="button" data-clone-copy data-copied="{{.i18n.Tr "ui.copied"}}" data-copy-failed="{{.i18n.Tr "ui.copy_failed"}}">{{.i18n.Tr "ui.copy"}}</button><span class="hg-meta" role="status" data-clone-status></span></div></section><script defer src="{{AppSubUrl}}/js/app/repository.js"></script>{{end}}
<section class="hg-landing-catalog" data-landing-catalog aria-labelledby="landing-repositories"><div class="hg-page-header"><h2 id="landing-repositories">{{.i18n.Tr "ui.explore_repositories"}}</h2><a href="{{AppSubUrl}}/explore?visibility=public">{{.i18n.Tr "ui.landing_all_public"}}</a></div><ul class="hg-repository-results">{{range .LandingRepositories}}<li><a href="{{AppSubUrl}}/{{.Owner.Name}}/{{.Name}}">{{.Owner.Name}} / {{.Name}}</a>{{if .Description}}<p>{{.Description}}</p>{{end}}</li>{{else}}<li class="hg-empty">{{.i18n.Tr "ui.no_repositories"}}</li>{{end}}</ul></section>
{{end}}
<p class="hg-landing-credit">{{.i18n.Tr "ui.mascot_credit_prefix"}} <a href="https://go.dev/blog/gopher">Renee French</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. {{.i18n.Tr "ui.mascot_credit_adaptation"}} <a href="{{AppSubUrl}}/img/hgs-mascot.LICENSE.md">{{.i18n.Tr "ui.artwork_provenance"}}</a></p>
</div>
{{template "shared/end" .}}
