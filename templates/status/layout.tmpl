{{define "status-layout"}}<!doctype html>
<html lang="{{.Lang}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}} · Hgs</title><link rel="icon" href="{{.SubURL}}/img/hgs-beaker.svg" type="image/svg+xml"><link rel="stylesheet" href="{{.SubURL}}/css/app.css"><link rel="stylesheet" href="{{.SubURL}}/css/status.css"></head>
<body class="hg-app hg-status"><a class="hg-skip" href="#main">{{index .Text "skip"}}</a>
<header class="status-wrap status-header"><a class="status-brand" href="{{.HomeURL}}"><img src="{{.SubURL}}/img/hgs-beaker.svg" width="30" height="34" alt=""><span>Hgs<b>.</b></span><small>{{index .Text "service"}}</small></a><a href="{{.HelpURL}}">{{index .Text "help"}}</a></header>
<main class="status-wrap" id="main" tabindex="-1"><section class="status-hero{{if .Help}} status-help{{end}}" aria-labelledby="status-title"><div class="status-copy">{{if not .Help}}<p class="status-eyebrow"><span>{{.Code}}</span> {{.Label}}</p>{{end}}<h1 id="status-title">{{.Title}}</h1><p class="status-lead">{{.Description}}</p>{{if .Message}}<p class="status-message">{{.Message}}</p>{{end}}<div class="status-actions"><a class="hg-button hg-button-primary" href="{{.HomeURL}}">{{.Primary}} <span aria-hidden="true">&#8594;</span></a>{{if not .Help}}<a class="hg-button" href="{{.HelpURL}}">{{index .Text "help"}}</a>{{end}}</div>{{if .Note}}<p class="status-note">{{.Note}}</p>{{end}}{{if .RequestID}}<p class="status-note">{{index .Text "reference"}}: <code>{{.RequestID}}</code></p>{{end}}</div>{{if not .Help}}<figure class="status-art"><img src="{{.SubURL}}{{.Illustration}}" alt="" width="1024" height="1024"></figure>{{end}}</section></main>
<footer class="status-wrap status-footer"><div><p><strong>{{index .Text "tagline"}}</strong></p><p>Hgs · {{index .Text "legal"}}</p><nav class="status-languages" aria-label="{{index .Text "language"}}"><a href="?lang=en-US" lang="en-US" hreflang="en-US"{{if eq .Lang "en-US"}} aria-current="true"{{end}}>English</a> · <a href="?lang=de-DE" lang="de-DE" hreflang="de-DE"{{if eq .Lang "de-DE"}} aria-current="true"{{end}}>Deutsch</a></nav></div><div><p>Go Gopher by <a href="https://go.dev/blog/gopher">Renee French</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p><p>{{index .Text "adaptation"}}</p></div></footer></body></html>{{end}}
