<p style="font-size:13px;overflow-wrap:anywhere;">Or copy this link into your browser:<br><a href="{{.AppUrl}}user/activate?code={{.Code}}" style="color:#0052CC;">{{.AppUrl}}user/activate?code={{.Code}}</a></p>
{{template "mail/footer" .}}
