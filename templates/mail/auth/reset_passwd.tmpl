{{template "mail/header" .}}
<p>Hi {{.User.Name}},</p>
<p>Please reset your password within <strong>{{.ActiveCodeLives}} hours</strong>.</p>
<p><a href="{{.AppUrl}}user/reset_password?code={{.Code}}" style="color:#0052CC;font-weight:bold;">Reset your password</a></p>
<p style="font-size:13px;overflow-wrap:anywhere;">Or copy this link into your browser:<br><a href="{{.AppUrl}}user/reset_password?code={{.Code}}" style="color:#0052CC;">{{.AppUrl}}user/reset_password?code={{.Code}}</a></p>
{{template "mail/footer" .}}
