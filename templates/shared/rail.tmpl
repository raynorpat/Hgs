<nav class="hg-rail" aria-label="{{.i18n.Tr "ui.utilities"}}">
<a class="hg-utility hg-brand" href="{{.Shell.SubURL}}/" aria-label="Hgs{{if and (AppName) (ne (AppName) "Hgs")}} · {{AppName}}{{end}}" title="Hgs{{if and (AppName) (ne (AppName) "Hgs")}} · {{AppName}}{{end}}"><img class="hg-icon" src="{{.Shell.SubURL}}/img/hgs-beaker-inverse.svg" alt="" width="32" height="32"></a>
{{if .UISearchURL}}<button type="button" class="hg-utility" data-popout data-popout-target="hg-search" aria-controls="hg-search" aria-expanded="false" aria-label="{{.i18n.Tr "ui.search"}}" title="{{.i18n.Tr "ui.search"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#search"/></svg></button>{{end}}
{{if or .Shell.SignedIn (not RequireSignInView)}}<a class="hg-utility" href="{{.Shell.SubURL}}/explore" aria-label="{{.i18n.Tr "ui.explore"}}" title="{{.i18n.Tr "ui.explore"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#compass"/></svg></a>{{end}}
{{if and .Shell.SignedIn .UIRecentsURL}}<button type="button" class="hg-utility" data-popout data-popout-target="hg-recents" aria-controls="hg-recents" aria-expanded="false" aria-label="{{.i18n.Tr "ui.recents"}}" title="{{.i18n.Tr "ui.recents"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#history"/></svg></button>{{end}}
{{if .Shell.SignedIn}}<button type="button" class="hg-utility" data-popout data-popout-target="hg-create" aria-controls="hg-create" aria-expanded="false" aria-label="{{.i18n.Tr "ui.create"}}" title="{{.i18n.Tr "ui.create"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#plus"/></svg></button>{{end}}
<div class="hg-rail-bottom">
{{if .Shell.CanAdmin}}<a class="hg-utility" href="{{.Shell.SubURL}}/admin" aria-label="{{.i18n.Tr "ui.administration"}}" title="{{.i18n.Tr "ui.administration"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#settings"/></svg></a>{{end}}
{{if .UIHelpURL}}<a class="hg-utility" href="{{.UIHelpURL}}" aria-label="{{.i18n.Tr "ui.help"}}" title="{{.i18n.Tr "ui.help"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#help"/></svg></a>{{end}}
{{if .Shell.SignedIn}}<button type="button" class="hg-utility" data-popout data-popout-target="hg-account" aria-controls="hg-account" aria-expanded="false" aria-label="{{.i18n.Tr "ui.account"}}" title="{{.i18n.Tr "ui.account"}}"><span class="hg-avatar"><span>{{.Shell.Initials}}</span>{{if .Shell.AvatarURL}}<img src="{{.Shell.AvatarURL}}" alt="" data-avatar>{{end}}</span></button>{{else}}<a class="hg-utility" href="{{.Shell.SubURL}}/user/login" aria-label="{{.i18n.Tr "ui.sign_in"}}" title="{{.i18n.Tr "ui.sign_in"}}"><svg class="hg-icon" aria-hidden="true"><use href="{{.Shell.SubURL}}/img/ui-icons.svg#account"/></svg></a>{{end}}
</div></nav><div class="hg-tooltip" id="hg-utility-tooltip" data-utility-tooltip role="tooltip" hidden></div>
{{if .UISearchURL}}{{template "shared/search" .}}{{end}}
{{if and .Shell.SignedIn .UIRecentsURL}}<section id="hg-recents" class="hg-popout" hidden aria-labelledby="hg-recents-title"><h2 id="hg-recents-title">{{.i18n.Tr "ui.recents"}}</h2>{{template "shared/recent" .}}<a href="{{.UIRecentsURL}}">{{.i18n.Tr "ui.manage_recents"}}</a></section>{{end}}
{{if .Shell.SignedIn}}{{template "shared/create_menu" .}}<section id="hg-account" class="hg-popout" hidden aria-labelledby="hg-account-title"><h2 id="hg-account-title">{{.SignedUser.Name}}</h2><a href="{{.SignedUser.HomeLink}}">{{.i18n.Tr "ui.profile"}}</a><a href="{{.Shell.SubURL}}/user/settings">{{.i18n.Tr "ui.settings"}}</a>{{if .UISignOutURL}}<form method="post" action="{{.UISignOutURL}}">{{.CsrfTokenHtml}}<button type="submit" class="hg-button">{{.i18n.Tr "ui.sign_out"}}</button></form>{{end}}</section>{{end}}
