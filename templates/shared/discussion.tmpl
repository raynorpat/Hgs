<div class="hg-discussion">
<article class="hg-panel" id="issue-description"><div class="hg-panel-heading"><a href="{{AppSubUrl}}/{{.Issue.Poster.Name}}">{{.Issue.Poster.Name}}</a> &middot; {{TimeSince .Issue.Created .Lang}}</div><div class="hg-markdown">{{if .Issue.RenderedContent}}{{Str2html .Issue.RenderedContent}}{{else}}<p class="hg-meta">{{.i18n.Tr "ui.no_comments"}}</p>{{end}}</div>
{{with .Issue.Attachments}}<ul class="hg-attachments">{{range .}}<li><a href="{{$.RepoLink}}/issues/{{$.Issue.Index}}/attachment/{{.Id}}">{{.Name}}</a></li>{{end}}</ul>{{end}}</article>
{{range .Comments}}<article id="issue-comment-{{.Id}}" class="{{if eq .Type 0}}hg-panel{{else}}hg-status-event{{end}}"><div class="hg-panel-heading"><a href="{{AppSubUrl}}/{{.Poster.Name}}">{{.Poster.Name}}</a> &middot; <a href="#issue-comment-{{.Id}}">{{TimeSince .Created $.Lang}}</a>{{if eq .Type 0}} &middot; {{$.i18n.Tr "ui.commented"}}{{else if eq .Type 1}} &middot; <span class="hg-badge hg-status-open">{{$.i18n.Tr "ui.reopened"}}</span>{{else if eq .Type 2}} &middot; <span class="hg-badge hg-status-closed">{{$.i18n.Tr "ui.closed"}}</span>{{end}}</div>{{if eq .Type 0}}<div class="hg-markdown">{{Str2html .Content}}</div>{{with .Attachments}}<ul class="hg-attachments">{{range .}}<li><a href="{{$.RepoLink}}/issues/{{$.Issue.Index}}/attachment/{{.Id}}">{{.Name}}</a></li>{{end}}</ul>{{end}}{{end}}</article>{{end}}</div>
