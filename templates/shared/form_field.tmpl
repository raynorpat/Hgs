<div class="hg-field"><label for="{{.ID}}">{{.Label}}{{if .Required}} <span aria-hidden="true">*</span>{{end}}</label><input id="{{.ID}}" name="{{.Name}}" type="{{if .Type}}{{.Type}}{{else}}text{{end}}"{{if ne .Type "password"}} value="{{.Value}}"{{end}}{{if .Required}} required{{end}}{{if or .Hint .Error}} aria-describedby="{{if .Hint}}{{.ID}}-hint {{end}}{{if .Error}}{{.ID}}-error{{end}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}>{{if .Hint}}<p id="{{.ID}}-hint" class="hg-meta">{{.Hint}}</p>{{end}}{{if .Error}}<p id="{{.ID}}-error" class="hg-field-error">{{.Error}}</p>{{end}}</div>
