<div class="hg-markdown-editor hg-field" data-markdown-editor data-markdown-url="{{.URL}}" data-markdown-context="{{.Context}}" data-preview-error="{{.Error}}">
<label for="{{.ID}}">{{.Label}}</label><div class="hg-tabs"><button type="button" data-markdown-write aria-pressed="true" aria-controls="{{.ID}}">{{.Write}}</button><button type="button" data-markdown-preview aria-pressed="false" aria-controls="{{.ID}}-preview">{{.Preview}}</button></div>
<textarea id="{{.ID}}" name="content" rows="10">{{.Value}}</textarea><div class="hg-markdown" id="{{.ID}}-preview" data-markdown-output hidden></div><p role="status" data-markdown-status></p></div>
