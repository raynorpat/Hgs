<aside class="hg-issue-metadata" aria-label="{{.i18n.Tr "ui.issues"}}">
{{if .Issue}}
<section><h3>{{.i18n.Tr "ui.labels"}}</h3><div class="hg-issue-labels">{{range .Issue.Labels}}<span class="hg-label" data-label-color="{{.Color}}">{{.Name}}</span>{{else}}<p class="hg-meta">{{.i18n.Tr "ui.no_labels"}}</p>{{end}}</div>
{{if .IsRepositoryOwner}}{{range .Labels}}<form action="{{$.RepoLink}}/issues/{{$.Issue.Index}}/label" method="post" data-prevent-duplicate>{{$.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><input type="hidden" name="id" value="{{.Id}}"><input type="hidden" name="action" value="{{if .IsChecked}}detach{{else}}attach{{end}}"><button class="hg-button hg-label-control" type="submit"><span class="hg-label" data-label-color="{{.Color}}">{{.Name}}</span> {{if .IsChecked}}{{$.i18n.Tr "ui.remove_label"}}{{else}}{{$.i18n.Tr "ui.attach_label"}}{{end}}</button></form>{{end}}{{end}}</section>
<section><h3>{{.i18n.Tr "ui.milestone"}}</h3>{{if .Milestone}}<a href="{{.RepoLink}}/issues?milestone={{.Milestone.Index}}">{{.Milestone.Name}}</a><progress max="100" value="{{.Milestone.Completeness}}">{{.Milestone.Completeness}}%</progress>{{else}}<p class="hg-meta">{{.i18n.Tr "ui.no_milestone"}}</p>{{end}}
{{if .IsRepositoryOwner}}<form action="{{.RepoLink}}/issues/{{.Issue.Index}}/milestone" method="post" data-prevent-duplicate>{{.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><input type="hidden" name="issue" value="{{.Issue.Id}}"><label for="milestoneid">{{.i18n.Tr "ui.milestone"}}</label><select id="milestoneid" name="milestoneid"><option value="0">{{.i18n.Tr "ui.no_milestone"}}</option>{{range .OpenMilestones}}<option value="{{.Id}}"{{if eq $.Issue.MilestoneId .Id}} selected{{end}}>{{.Name}}</option>{{end}}{{range .ClosedMilestones}}<option value="{{.Id}}"{{if eq $.Issue.MilestoneId .Id}} selected{{end}}>{{.Name}} &middot; {{$.i18n.Tr "ui.closed"}}</option>{{end}}</select><button class="hg-button" type="submit">{{.i18n.Tr "ui.save"}}</button></form>{{end}}</section>
<section><h3>{{.i18n.Tr "ui.assignee"}}</h3>{{if .Issue.Assignee}}<a href="{{AppSubUrl}}/{{.Issue.Assignee.Name}}">{{.Issue.Assignee.Name}}</a>{{else}}<p class="hg-meta">{{.i18n.Tr "ui.no_assignee"}}</p>{{end}}
{{if .IsRepositoryOwner}}<form action="{{.RepoLink}}/issues/{{.Issue.Index}}/assignee" method="post" data-prevent-duplicate>{{.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><input type="hidden" name="issue" value="{{.Issue.Id}}"><label for="assigneeid">{{.i18n.Tr "ui.assignee"}}</label><select name="assigneeid" id="assigneeid"><option value="0">{{.i18n.Tr "ui.no_assignee"}}</option>{{range .Collaborators}}<option value="{{.Id}}"{{if eq $.Issue.AssigneeId .Id}} selected{{end}}>{{.Name}}</option>{{end}}</select><button type="submit" class="hg-button">{{.i18n.Tr "ui.save"}}</button></form>{{end}}</section>
{{else}}{{if .IsRepositoryOwner}}
<div class="hg-field"><label for="assigneeid">{{.i18n.Tr "ui.assignee"}}</label><select id="assigneeid" name="assigneeid"><option value="0">{{.i18n.Tr "ui.no_assignee"}}</option>{{range .Collaborators}}<option value="{{.Id}}"{{if eq $.assigneeid .Id}} selected{{end}}>{{.Name}}</option>{{end}}</select></div>
<div class="hg-field"><label for="milestoneid">{{.i18n.Tr "ui.milestone"}}</label><select id="milestoneid" name="milestoneid"><option value="0">{{.i18n.Tr "ui.no_milestone"}}</option>{{range .OpenMilestones}}<option value="{{.Id}}"{{if eq $.milestoneid .Id}} selected{{end}}>{{.Name}}</option>{{end}}{{range .ClosedMilestones}}<option value="{{.Id}}"{{if eq $.milestoneid .Id}} selected{{end}}>{{.Name}} &middot; {{$.i18n.Tr "ui.closed"}}</option>{{end}}</select></div>
{{end}}{{end}}</aside>
