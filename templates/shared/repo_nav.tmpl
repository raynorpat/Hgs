<nav aria-label="{{.i18n.Tr "ui.repository"}}">{{range .Shell.Navigation}}<a class="hg-nav-item" href="{{.URL}}" title="{{.Label}}"{{if .Active}} aria-current="page"{{end}}><svg class="hg-icon" aria-hidden="true"><use href="{{$.Shell.SubURL}}/img/ui-icons.svg#{{.Icon}}"/></svg><span>{{.Label}}</span>{{if .Count}}<span class="hg-count">{{.Count}}</span>{{end}}</a>{{if eq .Key "workspace"}}<p class="hg-context-caption hg-repository-identity" title="{{$.UIRepositoryName}}">{{$.UIRepositoryName}}</p>{{end}}{{end}}</nav>
