<div data-draft-controls data-draft-api="{{AppSubUrl}}/user/drafts" data-draft-actor="{{.SignedUser.Id}}" data-draft-repository="{{.Repository.Id}}" data-draft-session-established="{{.DraftSessionEstablished}}"
 data-saving="{{.i18n.Tr "drafts.saving"}}" data-saved="{{.i18n.Tr "drafts.saved"}}" data-failed="{{.i18n.Tr "drafts.failed"}}" data-expired="{{.i18n.Tr "drafts.expired"}}" data-cleared="{{.i18n.Tr "drafts.cleared"}}" data-unavailable="{{.i18n.Tr "drafts.unavailable"}}" data-limit="{{.i18n.Tr "drafts.limit"}}" data-invalid="{{.i18n.Tr "drafts.invalid"}}" data-unknown="{{.i18n.Tr "drafts.unknown"}}" data-partial="{{.i18n.Tr "drafts.partial"}}" data-cancelled="{{.i18n.Tr "drafts.cancelled"}}" data-reselect="{{.i18n.Tr "drafts.reselect"}}">
