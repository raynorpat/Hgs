<details class="hg-revision-selector"><summary class="hg-button">{{.i18n.Tr "ui.revision"}}: {{.Changeset.Branch}} · {{ShortSha .Node}}</summary><div class="hg-revision-options"><h2 class="hg-subheading">{{.i18n.Tr "repo.hg_references"}}</h2><ul>{{range .References}}<li><a href="{{.SelectionURL}}" data-revision-kind="{{.Kind}}" data-node="{{.Node}}">{{$.i18n.Tr (printf "ui.reference_%s" .Kind)}}: {{.Name}} · {{ShortSha .Node}}{{if .Closed}} ({{$.i18n.Tr "repo.hg_closed"}}){{end}}</a></li>{{end}}</ul></div></details>
