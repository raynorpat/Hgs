<p class="hg-context-caption">{{.i18n.Tr "ui.workspace_context"}}</p><nav aria-label="{{.i18n.Tr "ui.workspace_context"}}">{{range .Shell.Navigation}}<a class="hg-nav-item" href="{{.URL}}" title="{{.Label}}"{{if .Active}} aria-current="page"{{end}}><svg class="hg-icon" aria-hidden="true"><use href="{{$.Shell.SubURL}}/img/ui-icons.svg#{{.Icon}}"/></svg><span>{{.Label}}</span>{{if .Count}}<span class="hg-count">{{.Count}}</span>{{end}}</a>{{end}}</nav>
