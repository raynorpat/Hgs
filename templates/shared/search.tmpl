<section id="hg-search" class="hg-popout" hidden aria-labelledby="hg-search-title"><h2 id="hg-search-title">{{.i18n.Tr "ui.search"}}</h2>
<form action="{{.Shell.SubURL}}/explore" method="get" data-repository-search data-search-url="{{.UISearchURL}}" data-search-error="{{.i18n.Tr "ui.search_error"}}"><label for="hg-search-input">{{.i18n.Tr "ui.search_repositories"}}</label><input id="hg-search-input" name="q" type="search" maxlength="200" autocomplete="off" data-popout-focus><button class="hg-button" type="submit">{{.i18n.Tr "ui.search"}}</button><p role="status" data-search-status></p><div data-search-results aria-live="polite"></div></form></section>
