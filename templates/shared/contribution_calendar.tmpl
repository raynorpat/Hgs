<section class="hg-contributions" aria-labelledby="contribution-heading" data-contribution-calendar>
<div class="hg-profile-section-heading"><h2 id="contribution-heading">{{if eq .Profile.Page.State "unavailable"}}{{.i18n.Tr "profile.heading"}}{{else}}{{.i18n.Tr "profile.contributions" .Profile.Total}}{{end}}</h2>
<form method="get" action="{{.Profile.URL}}" class="hg-profile-filter"><input type="hidden" name="tab" value="{{.Profile.Tab}}">{{if .Profile.Query.Kind}}<input type="hidden" name="kind" value="{{.Profile.Query.Kind}}">{{end}}<label for="contribution-year">{{.i18n.Tr "profile.year"}}</label><select id="contribution-year" name="year">{{if .Profile.SelectedYearMissing}}<option value="{{.Profile.Query.Year}}" selected>{{.Profile.Query.Year}}</option>{{end}}{{range .Profile.Page.Years}}<option value="{{.}}"{{if eq . $.Profile.Query.Year}} selected{{end}}>{{.}}</option>{{end}}</select><button class="hg-button" type="submit">{{.i18n.Tr "profile.apply"}}</button></form></div>
<p class="hg-meta" id="contribution-utc">{{.i18n.Tr "profile.utc_help"}}</p>
<p class="hg-meta" data-contribution-state="{{.Profile.Page.State}}">{{.i18n.Tr (printf "profile.state_%s" .Profile.Page.State)}}{{if not .Profile.Page.IndexedAt.IsZero}} &middot; {{.i18n.Tr "profile.indexed"}} <time datetime="{{.Profile.Page.IndexedAt.Format "2006-01-02T15:04:05Z"}}">{{.Profile.Page.IndexedAt.Format "2006-01-02 15:04 UTC"}}</time>{{end}}</p>
{{if and (not .Profile.Error) .Profile.Days}}
<div class="hg-calendar-box"><div class="hg-calendar-scroll" tabindex="0" role="region" aria-label="{{.i18n.Tr "profile.calendar"}}" aria-describedby="contribution-utc"><div class="hg-calendar-months" aria-hidden="true">{{range .Profile.CalendarMonths}}<span style="grid-column-start: {{.Column}}">{{$.i18n.Tr .Key}}</span>{{end}}</div><div class="hg-calendar-grid" style="--calendar-start: {{.Profile.StartDay}}">
{{range .Profile.Days}}<a href="{{.URL}}" tabindex="-1" class="hg-calendar-day hg-contribution-{{.Level}}{{if .Selected}} is-selected{{end}}" aria-label="{{$.i18n.Tr "profile.day_count" .Date .Count}}" title="{{$.i18n.Tr "profile.day_count" .Date .Count}}"{{if .Selected}} aria-current="date"{{end}}></a>{{end}}
</div></div><div class="hg-calendar-legend"><span>{{.i18n.Tr "profile.less"}}</span><i class="hg-contribution-0"></i><i class="hg-contribution-1"></i><i class="hg-contribution-2"></i><i class="hg-contribution-3"></i><i class="hg-contribution-4"></i><span>{{.i18n.Tr "profile.more"}}</span></div>
<form method="get" action="{{.Profile.URL}}" class="hg-profile-filter hg-date-filter"><input type="hidden" name="tab" value="{{.Profile.Tab}}"><input type="hidden" name="year" value="{{.Profile.Query.Year}}">{{if .Profile.Query.Kind}}<input type="hidden" name="kind" value="{{.Profile.Query.Kind}}">{{end}}<label for="contribution-day">{{.i18n.Tr "profile.date"}}</label><input id="contribution-day" type="date" name="day" value="{{.Profile.Query.Day}}" min="{{printf "%04d-01-01" .Profile.Query.Year}}" max="{{printf "%04d-12-31" .Profile.Query.Year}}"><button class="hg-button" type="submit">{{.i18n.Tr "profile.apply"}}</button>{{if .Profile.Query.Day}}<a href="{{.Profile.ClearURL}}">{{.i18n.Tr "profile.clear"}}</a>{{end}}</form>
<dl class="hg-profile-metrics"><div><dt>{{.i18n.Tr "profile.changeset"}}</dt><dd>{{.Profile.Page.Totals.Changesets}}</dd></div><div><dt>{{.i18n.Tr "profile.pull"}}</dt><dd>{{.Profile.Page.Totals.Pulls}}</dd></div><div><dt>{{.i18n.Tr "profile.issue"}}</dt><dd>{{.Profile.Page.Totals.Issues}}</dd></div><div><dt>{{.i18n.Tr "profile.review"}}</dt><dd>{{.Profile.Page.Totals.Reviews}}</dd></div></dl></div>
<details class="hg-profile-date-list"><summary>{{.i18n.Tr "profile.date_list"}}</summary><ul>{{range .Profile.Days}}{{if .Count}}<li><a href="{{.URL}}">{{$.i18n.Tr "profile.day_count" .Date .Count}}</a></li>{{end}}{{end}}</ul></details>
{{end}}</section>
