<section class="hg-profile-activity" id="contribution-activity" aria-labelledby="activity-heading"><h2 id="activity-heading">{{.i18n.Tr "user.activity"}}</h2>
<nav class="hg-profile-filters" aria-label="{{.i18n.Tr "profile.kind"}}">{{range .Profile.Filters}}<a href="{{.URL}}"{{if .Active}} aria-current="true"{{end}}>{{$.i18n.Tr (printf "profile.%s" .Key)}}</a>{{end}}</nav>
{{if not .Profile.Error}}{{range .Profile.Groups}}{{if .Month}}<h3 class="hg-profile-month"><time datetime="{{.Month}}">{{.Month}} &middot; UTC</time></h3>{{end}}
<article class="hg-profile-event"><h4>{{$.i18n.Tr (printf "profile.%s" .Kind)}} &middot; {{.Count}} &middot; <a href="{{.RepositoryURL}}">{{.Title}}</a></h4>{{if .Status}}<p class="hg-meta">{{$.i18n.Tr (printf "profile.status_%s" .Status)}}</p>{{end}}{{if eq .Kind "repository"}}<p class="hg-meta">{{$.i18n.Tr "profile.timeline_only"}}</p>{{end}}<ul>{{range .Links}}<li><a href="{{.URL}}">{{.Label}}</a></li>{{end}}</ul>{{if .Capped}}<p>{{$.i18n.Tr "profile.showing" (len .Links) .Count}} &middot; <a href="{{.RepositoryURL}}">{{$.i18n.Tr "profile.repository_list"}}</a></p>{{end}}</article>
{{else}}<p class="hg-empty">{{if eq .Profile.Page.State "ready"}}{{.i18n.Tr "profile.empty"}}{{else}}{{.i18n.Tr "profile.pending_empty"}}{{end}}</p>{{end}}
{{if .Profile.NextURL}}<a class="hg-button hg-profile-more" href="{{.Profile.NextURL}}#contribution-activity">{{.i18n.Tr "profile.show_more"}}</a>{{end}}{{end}}</section>
