{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.monitor.cron"}}</strong>
                            </div>
                            <div class="hg-panel-body admin-panel">
                                <div class="hg-table-scroll" tabindex="0" role="region" aria-label="{{.Title}}"><table class="hg-table table-striped">
                                    <thead>
                                        <tr>
                                            <th>{{.i18n.Tr "admin.monitor.name"}}</th>
                                            <th>{{.i18n.Tr "admin.monitor.schedule"}}</th>
                                            <th>{{.i18n.Tr "admin.monitor.next"}}</th>
                                            <th>{{.i18n.Tr "admin.monitor.previous"}}</th>
                                            <th>{{.i18n.Tr "admin.monitor.execute_times"}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{range .Entries}}
                                        <tr>
                                            <td>{{.Description}}</td>
                                            <td>{{.Spec}}</td>
                                            <td>{{.Next}}</td>
                                            <td>{{.Prev}}</td>
                                            <td>{{.ExecTimes}}</td>
                                        </tr>
                                        {{end}}
                                    </tbody>
                                </table></div>
                            </div>
                        </div>
                        <br>
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.monitor.process"}}</strong>
                            </div>
                            <div class="hg-panel-body admin-panel">
                                <div class="hg-table-scroll" tabindex="0" role="region" aria-label="{{.Title}}"><table class="hg-table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Pid</th>
                                            <th>{{.i18n.Tr "admin.monitor.desc"}}</th>
                                            <th>{{.i18n.Tr "admin.monitor.start"}}</th>
                                            <th>{{.i18n.Tr "admin.monitor.execute_time"}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{range .Processes}}
                                        <tr>
                                            <td>{{.Pid}}</td>
                                            <td>{{.Description}}</td>
                                            <td>{{.Start}}</td>
                                            <td>{{TimeSince .Start $.Lang}}</td>
                                        </tr>
                                        {{end}}
                                    </tbody>
                                </table></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
