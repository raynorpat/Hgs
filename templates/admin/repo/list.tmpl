{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.repos.repo_manage_panel"}}</strong>
                            </div>
                            <div class="hg-panel-body admin-panel">
                                <div class="admin-table">
                                    <div class="hg-table-scroll" tabindex="0" role="region" aria-label="{{.Title}}"><table class="hg-table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>{{.i18n.Tr "admin.repos.owner"}}</th>
                                                <th class="hg-admin-repo-name">{{.i18n.Tr "admin.repos.name"}}</th>
                                                <th>{{.i18n.Tr "admin.repos.private"}}</th>
                                                <th>{{.i18n.Tr "admin.repos.watches"}}</th>
                                                <th>{{.i18n.Tr "admin.repos.stars"}}</th>
                                                <th>{{.i18n.Tr "admin.repos.issues"}}</th>
                                                <th>{{.i18n.Tr "admin.users.created"}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{range .Repos}}
                                            <tr>
                                                <td>{{.Id}}</td>
                                                <td><a href="{{AppSubUrl}}/{{.Owner.Name}}">{{.Owner.Name}}</a></td>
                                                <td class="hg-admin-repo-name"><a href="{{AppSubUrl}}/{{.Owner.Name}}/{{.Name}}">{{.Name}}</a></td>
                                                <td>{{if .IsPrivate}}{{$.i18n.Tr "ui.yes"}}{{else}}{{$.i18n.Tr "ui.no"}}{{end}}</td>
                                                <td>{{.NumWatches}}</td>
                                                <td>{{.NumStars}}</td>
                                                <td>{{.NumIssues}}</td>
                                                <td><span title="{{DateFormat .Created "r"}}">{{DateFormat .Created "M d, Y"}}</span></td>
                                            </tr>
                                            {{end}}
                                        </tbody>
                                    </table></div>
                                    {{if or .LastPageNum .NextPageNum}}
                                    <ul class="pagination">
                                        {{if .LastPageNum}}<li><a class="hg-button " href="{{AppSubUrl}}/admin/repos?p={{.LastPageNum}}">&laquo; {{.i18n.Tr "admin.prev"}}</a></li>{{end}}
                                        {{if .NextPageNum}}<li><a class="hg-button " href="{{AppSubUrl}}/admin/repos?p={{.NextPageNum}}">&raquo; {{.i18n.Tr "admin.next"}}</a></li>{{end}}
                                    </ul>
                                    {{end}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
