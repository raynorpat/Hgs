{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.notices.system_notice_list"}}</strong>
                            </div>
                            <div class="hg-panel-body admin-panel">
                                <div class="admin-table">
                                    <div class="hg-table-scroll"><table class="hg-table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>{{.i18n.Tr "admin.notices.type"}}</th>
                                                <th>{{.i18n.Tr "admin.notices.desc"}}</th>
                                                <th>{{.i18n.Tr "admin.users.created"}}</th>
                                                <th>{{.i18n.Tr "admin.notices.op"}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{range .Notices}}
                                            <tr>
                                                <td>{{.Id}}</td>
                                                <td>{{$.i18n.Tr .TrStr}}</td>
                                                <td class="grid-1-2"><span>{{.Description}}</span></td>
                                                <td>{{.Created}}</td>
                                                <td><form class="hg-inline-form" method="post" action="{{AppSubUrl}}/admin/notices/{{.Id}}/delete" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "settings.delete"}}</button></form></td>
                                            </tr>
                                            {{end}}
                                        </tbody>
                                    </table></div>
                                    {{if or .LastPageNum .NextPageNum}}
                                    <ul class="pagination">
                                        {{if .LastPageNum}}<li><a class="hg-button " href="{{AppSubUrl}}/admin/notices?p={{.LastPageNum}}">&laquo; {{.i18n.Tr "admin.prev"}}</a></li>{{end}}
                                        {{if .NextPageNum}}<li><a class="hg-button " href="{{AppSubUrl}}/admin/notices?p={{.NextPageNum}}">&raquo; {{.i18n.Tr "admin.next"}}</a></li>{{end}}
                                    </ul>
                                    {{end}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
