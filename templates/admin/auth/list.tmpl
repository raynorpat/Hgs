{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.auths.auth_manage_panel"}}</strong>
                            </div>
                            <div class="hg-panel-body admin-panel">
                                <a class="hg-button hg-button-primary" href="{{AppSubUrl}}/admin/auths/new">{{.i18n.Tr "admin.auths.new"}}</a>
                                <div class="admin-table">
                                    <div class="hg-table-scroll" tabindex="0" role="region" aria-label="{{.Title}}"><table class="hg-table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th>{{.i18n.Tr "admin.auths.name"}}</th>
                                                <th>{{.i18n.Tr "admin.auths.type"}}</th>
                                                <th>{{.i18n.Tr "admin.auths.enabled"}}</th>
                                                <th>{{.i18n.Tr "admin.auths.updated"}}</th>
                                                <th>{{.i18n.Tr "admin.users.created"}}</th>
                                                <th>{{.i18n.Tr "admin.users.edit"}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{range .Sources}}
                                            <tr>
                                                <td>{{.Id}}</td>
                                                <td><a href="{{AppSubUrl}}/admin/auths/{{.Id}}">{{.Name}}</a></td>
                                                <td>{{.TypeString}}</td>
                                                <td>{{if .IsActived}}{{$.i18n.Tr "ui.yes"}}{{else}}{{$.i18n.Tr "ui.no"}}{{end}}</td>
                                                <td><span title="{{DateFormat .Updated "r"}}">{{DateFormat .Updated "M d, Y"}}</span></td>
                                                <td><span title="{{DateFormat .Created "r"}}">{{DateFormat .Created "M d, Y"}}</span></td>
                                                <td><a href="{{AppSubUrl}}/admin/auths/{{.Id}}">{{$.i18n.Tr "ui.edit"}}</a></td>
                                            </tr>
                                            {{end}}
                                        </tbody>
                                    </table></div>
                                    {{if or .LastPageNum .NextPageNum}}
                                    <ul class="pagination">
                                        {{if .LastPageNum}}<li><a class="hg-button " href="{{AppSubUrl}}/admin/auths?p={{.LastPageNum}}">&laquo; {{.i18n.Tr "admin.prev"}}</a></li>{{end}}
                                        {{if .NextPageNum}}<li><a class="hg-button " href="{{AppSubUrl}}/admin/auths?p={{.NextPageNum}}">&raquo; {{.i18n.Tr "admin.next"}}</a></li>{{end}}
                                    </ul>
                                    {{end}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
