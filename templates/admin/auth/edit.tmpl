{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.auths.edit"}}</strong>
                            </div>
                            <form class="hg-form hg-panel-body" id="auth-setting-form" action="{{AppSubUrl}}/admin/auths/{{.Source.Id}}" method="post" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <input type="hidden" value="{{.Source.Id}}" name="id"/>
                                {{$type := .Source.Type}}
                                <div class="hg-field">
                                    <label>{{.i18n.Tr "admin.auths.auth_type"}}</label>
                                    <input type="hidden" name="type" value="{{.Source.Type}}"/>
                                    <label class="control-label">
                                        {{range $key, $val := .LoginTypes}}
                                            {{if eq $key $type}}{{$val}}{{end}}
                                        {{end}}
                                    </label>
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="name">{{.i18n.Tr "admin.auths.auth_name"}}</label>
                                    <input  id="name" name="name" value="{{if .HasError}}{{.name}}{{else}}{{.Source.Name}}{{end}}" required  {{if .Err_AuthName}}aria-invalid="true" aria-describedby="name-error"{{end}}>{{if .Err_AuthName}}<span class="hg-field-error" id="name-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>

                                {{if eq $type 2}}
                                <div class="hg-field">
                                    <label class="req" for="domain">{{.i18n.Tr "admin.auths.domain"}}</label>
                                    <input  id="domain" name="domain" value="{{if .HasError}}{{.domain}}{{else}}{{.Source.LDAP.Name}}{{end}}" required  {{if .Err_Domain}}aria-invalid="true" aria-describedby="domain-error"{{end}}>{{if .Err_Domain}}<span class="hg-field-error" id="domain-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="host">{{.i18n.Tr "admin.auths.host"}}</label>
                                    <input  id="host" name="host" value="{{if .HasError}}{{.host}}{{else}}{{.Source.LDAP.Host}}{{end}}" required  {{if .Err_Host}}aria-invalid="true" aria-describedby="host-error"{{end}}>{{if .Err_Host}}<span class="hg-field-error" id="host-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="port">{{.i18n.Tr "admin.auths.port"}}</label>
                                    <input  id="port" name="port" value="{{if .HasError}}{{.port}}{{else}}{{.Source.LDAP.Port}}{{end}}" required  {{if .Err_Port}}aria-invalid="true" aria-describedby="port-error"{{end}}>{{if .Err_Port}}<span class="hg-field-error" id="port-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="base_dn">{{.i18n.Tr "admin.auths.base_dn"}}</label>
                                    <input  id="base_dn" name="base_dn" value="{{if .HasError}}{{.base_dn}}{{else}}{{.Source.LDAP.BaseDN}}{{end}}"  {{if .Err_BaseDN}}aria-invalid="true" aria-describedby="base_dn-error"{{end}}>{{if .Err_BaseDN}}<span class="hg-field-error" id="base_dn-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="attributes">{{.i18n.Tr "admin.auths.attributes"}}</label>
                                    <input  id="attributes" name="attributes" value="{{if .HasError}}{{.attributes}}{{else}}{{.Source.LDAP.Attributes}}{{end}}"  {{if .Err_Attributes}}aria-invalid="true" aria-describedby="attributes-error"{{end}}>{{if .Err_Attributes}}<span class="hg-field-error" id="attributes-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="filter">{{.i18n.Tr "admin.auths.filter"}}</label>
                                    <input  id="filter" name="filter" value="{{if .HasError}}{{.filter}}{{else}}{{.Source.LDAP.Filter}}{{end}}"  {{if .Err_Filter}}aria-invalid="true" aria-describedby="filter-error"{{end}}>{{if .Err_Filter}}<span class="hg-field-error" id="filter-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="ms_ad_sa">{{.i18n.Tr "admin.auths.ms_ad_sa"}}</label>
                                    <input  id="ms_ad_sa" name="ms_ad_sa" value="{{if .HasError}}{{.ms_ad_sa}}{{else}}{{.Source.LDAP.MsAdSAFormat}}{{end}}"  {{if .Err_MsAdSA}}aria-invalid="true" aria-describedby="ms_ad_sa-error"{{end}}>{{if .Err_MsAdSA}}<span class="hg-field-error" id="ms_ad_sa-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>

                                {{else if eq $type 3}}
                                <div class="hg-field">
                                    <label class="req" for="smtp-auth">{{.i18n.Tr "admin.auths.smtp_auth"}}</label>
                                    <select id="smtp-auth" name="smtpauth">
                                        {{$auth := .Source.SMTP.Auth}}
                                        {{range .SMTPAuths}}
                                        <option value="{{.}}"
                                        {{if eq . $auth}} selected{{end}}>{{.}}</option>
                                        {{end}}
                                    </select>
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="smtphost">{{.i18n.Tr "admin.auths.smtphost"}}</label>
                                    <input  id="smtphost" name="smtphost" value="{{if .HasError}}{{.smtphost}}{{else}}{{.Source.SMTP.Host}}{{end}}"  {{if .Err_SmtpHost}}aria-invalid="true" aria-describedby="smtphost-error"{{end}}>{{if .Err_SmtpHost}}<span class="hg-field-error" id="smtphost-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="smtpport">{{.i18n.Tr "admin.auths.smtpport"}}</label>
                                    <input  id="smtpport" name="smtpport" value="{{if .HasError}}{{.smtpport}}{{else}}{{.Source.SMTP.Port}}{{end}}"  {{if .Err_SmtpPort}}aria-invalid="true" aria-describedby="smtpport-error"{{end}}>{{if .Err_SmtpPort}}<span class="hg-field-error" id="smtpport-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                {{end}}

                                <div class="hg-field">
                                    {{if eq $type 3}}
                                    <label class="hg-choice"><input name="tls" type="checkbox" {{if .HasError}}{{if .tls}}checked{{end}}{{else}}{{if .Source.SMTP.TLS}}checked{{end}}{{end}}>
                                    <strong>{{.i18n.Tr "admin.auths.enable_tls"}}</strong></label>
                                    <br>
                                    {{end}}
                                    <label class="hg-choice"><input name="allowautoregister" type="checkbox" {{if .HasError}}{{if .allowautoregister}}checked{{end}}{{else}}{{if .Source.AllowAutoRegister}}checked{{end}}{{end}}>
                                    <strong>{{.i18n.Tr "admin.auths.enable_auto_register"}}</strong></label>
                                    <br>
                                    <label class="hg-choice"><input name="is_actived" type="checkbox" {{if .HasError}}{{if .is_actived}}checked{{end}}{{else}}{{if .Source.IsActived}}checked{{end}}{{end}}>
                                    <strong>{{.i18n.Tr "admin.auths.activated"}}</strong></label>
                                </div>
                                <div class="hg-field">
                                    <button class="hg-button hg-button-primary">{{.i18n.Tr "admin.auths.update"}}</button>
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                    <button class="hg-button hg-button-danger" id="delete-auth-btn" type="submit" formnovalidate formaction="{{AppSubUrl}}/admin/auths/{{.Source.Id}}/delete" data-confirm-message="{{.i18n.Tr "ui.confirm_action"}}">{{.i18n.Tr "admin.auths.delete"}}</button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
