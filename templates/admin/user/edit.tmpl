{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.users.edit_account"}}</strong>
                            </div>
                            <form class="hg-form hg-panel-body" id="user-profile-form" action="{{AppSubUrl}}/admin/users/{{.User.Id}}" method="post" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <div class="hg-field">
                                    <label class="req" for="login-type">{{.i18n.Tr "admin.users.auth_source"}}</label>
                                    <select id="login-type" name="logintype">
                                        <option value="0-0">{{.i18n.Tr "admin.users.local"}}</option>
                                        {{$tp := .User.LoginSource}}
                                        {{range $key, $val := .LoginSources}}
                                        <option value="{{$val.Type}}-{{$val.Id}}"{{if eq $val.Id $tp}} selected{{end}}>{{$val.Name}}</option>
                                        {{end}}
                                    </select>
                                </div>
                                <div class="hg-field">
                                    <label for="loginname">{{.i18n.Tr "admin.users.auth_login_name"}}</label>
                                    <input  id="loginname" name="loginname" value="{{.User.LoginName}}"  {{if .Err_LoginName}}aria-invalid="true" aria-describedby="loginname-error"{{end}}>{{if .Err_LoginName}}<span class="hg-field-error" id="loginname-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label>{{.i18n.Tr "username"}}</label>
                                    <label class="text-left">{{.User.Name}}</label>
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                                    <input  id="email" name="email" type="email" value="{{if .HasError}}{{.email}}{{else}}{{.User.Email}}{{end}}" required {{if .Err_Email}}aria-invalid="true" aria-describedby="email-error"{{end}}>{{if .Err_Email}}<span class="hg-field-error" id="email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field pwd">
                                    <label for="password">{{.i18n.Tr "password"}}</label>
                                    <input  id="password" name="password" type="password"  {{if .Err_Password}}aria-invalid="true" aria-describedby="password-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="password-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label for="website">{{.i18n.Tr "settings.website"}}</label>
                                    <input  id="website" name="website" type="url" value="{{if .HasError}}{{.website}}{{else}}{{.User.Website}}{{end}}"  {{if .Err_Website}}aria-invalid="true" aria-describedby="website-error"{{end}}>{{if .Err_Website}}<span class="hg-field-error" id="website-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label for="location">{{.i18n.Tr "settings.location"}}</label>
                                    <input  id="location" name="location" type="text" value="{{if .HasError}}{{.location}}{{else}}{{.User.Location}}{{end}}"  {{if .Err_Location}}aria-invalid="true" aria-describedby="location-error"{{end}}>{{if .Err_Location}}<span class="hg-field-error" id="location-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label for="gravatar-email">Gravatar {{.i18n.Tr "email"}}</label>
                                    <input  id="gravatar-email" name="avatar" type="text" value="{{if .HasError}}{{.avatar}}{{else}}{{.User.AvatarEmail}}{{end}}"  {{if .Err_Avatar}}aria-invalid="true" aria-describedby="gravatar-email-error"{{end}}>{{if .Err_Avatar}}<span class="hg-field-error" id="gravatar-email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="hg-choice"><input type="checkbox" name="active" {{if .HasError}}{{if .active}}checked{{end}}{{else}}{{if .User.IsActive}}checked{{end}}{{end}}>
                                    <strong>{{.i18n.Tr "admin.users.is_activated"}}</strong></label>
                                    <br>
                                    <label class="hg-choice"><input type="checkbox" name="admin" {{if .HasError}}{{if .admin}}checked{{end}}{{else}}{{if .User.IsAdmin}}checked{{end}}{{end}}>
                                    <strong>{{.i18n.Tr "admin.users.is_admin"}}</strong></label>
                                </div>
                                <div class="hg-field">
                                    <button class="hg-button hg-button-primary">{{.i18n.Tr "admin.users.update_profile"}}</button>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                    <button class="hg-button hg-button-danger" id="delete-account-btn" type="submit" formnovalidate formaction="{{AppSubUrl}}/admin/users/{{.User.Id}}/delete" data-confirm-message="{{.i18n.Tr "ui.confirm_action"}}">{{.i18n.Tr "admin.users.delete_account"}}</button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
