{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="admin-wrapper">
    <div id="setting-wrapper" class="">
        <div id="admin-setting" class="">

            <div class="">
                <div class="setting-content">

                    <div id="setting-content">
                        <div class="hg-panel">
                            <div class="hg-panel-heading">
                                <strong>{{.i18n.Tr "admin.users.new_account"}}</strong>
                            </div>
                            <form class="hg-form hg-panel-body" id="repo-setting-form" data-account-create action="{{AppSubUrl}}/admin/users/new" method="post" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <div class="hg-field">
                                    <label class="req" for="login-type">{{.i18n.Tr "admin.users.auth_source"}}</label>
                                    <select id="login-type" name="logintype">
                                        <option value="0-0">{{.i18n.Tr "admin.users.local"}}</option>
                                        {{range $key, $val := .LoginSources}}
                                        <option value="{{$val.Type}}-{{$val.Id}}" {{if eq (printf "%d-%d" $val.Type $val.Id) $.logintype}}selected{{end}}>{{$val.Name}}</option>
                                        {{end}}
                                    </select>
                                </div>
                                <div class="hg-field auth-name hidden">
                                    <label class="req" for="loginname">{{.i18n.Tr "admin.users.auth_login_name"}}</label>
                                    <input  id="loginname" name="loginname" value="{{.loginname}}"  {{if .Err_LoginName}}aria-invalid="true" aria-describedby="loginname-error"{{end}}>{{if .Err_LoginName}}<span class="hg-field-error" id="loginname-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="username">{{.i18n.Tr "username"}}</label>
                                    <input  id="username" name="uname" type="text" value="{{.uname}}" required  {{if .Err_UserName}}aria-invalid="true" aria-describedby="username-error"{{end}}>{{if .Err_UserName}}<span class="hg-field-error" id="username-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                                    <input  id="email" name="email" type="email" value="{{.email}}" required {{if .Err_Email}}aria-invalid="true" aria-describedby="email-error"{{end}}>{{if .Err_Email}}<span class="hg-field-error" id="email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <p class="auth-name hg-meta">{{.i18n.Tr "ui.provider_initial_password"}}</p>
 <div class="hg-field pwd">
                                    <label class="req" for="password">{{.i18n.Tr "password"}}</label>
                                    <input  id="password" name="password" type="password" required {{if .Err_Password}}aria-invalid="true" aria-describedby="password-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="password-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="re-type">{{.i18n.Tr "re_type"}}</label>
                                    <input  id="re-type" name="retype" type="password" required {{if .Err_Password}}aria-invalid="true" aria-describedby="re-type-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="re-type-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <button class="hg-button hg-button-primary">{{.i18n.Tr "admin.users.new_account"}}</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
