{{template "shared/start" .}}
<article data-local-help>
<h1>{{.i18n.Tr "ui.help"}}</h1>
<p>{{.i18n.Tr "help.intro"}}</p>
<section aria-labelledby="help-browse"><h2 id="help-browse">{{.i18n.Tr "help.browse_title"}}</h2>
<p>{{.i18n.Tr "help.browse"}}</p></section>
<section aria-labelledby="help-clone"><h2 id="help-clone">{{.i18n.Tr "help.clone_title"}}</h2>
<p>{{.i18n.Tr "help.clone"}}</p>
<p>{{.i18n.Tr "help.http"}}</p>
{{if .HelpSSHEnabled}}<p data-help-ssh>{{.i18n.Tr "help.ssh"}} <a href="{{AppSubUrl}}/user/settings/ssh">{{.i18n.Tr "settings.ssh_keys"}}</a></p>{{end}}
<p>{{.i18n.Tr "help.local"}}</p>
<pre><code>hg pull
hg update
hg status
hg add
hg commit
hg push</code></pre>
<p>{{.i18n.Tr "help.write_access"}}</p></section>
<section aria-labelledby="help-discuss"><h2 id="help-discuss">{{.i18n.Tr "help.discuss_title"}}</h2>
<p>{{.i18n.Tr "help.discuss"}}</p>
<p>{{.i18n.Tr "help.watch_star"}}</p></section>
<p><a href="https://www.mercurial-scm.org/guide">{{.i18n.Tr "help.documentation"}}</a></p>
</article>
{{template "shared/end" .}}
