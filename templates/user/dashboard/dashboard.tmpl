{{template "shared/start" .}}{{template "user/dashboard/nav" .}}<div class="hg-workspace-grid">
<section>
<h2>{{.i18n.Tr "news_feed"}}</h2>{{template "user/dashboard/feeds" .}}</section>
<div>
<section id="repositories">
<div class="hg-page-header">
<h2>{{.i18n.Tr "home.my_repos"}}</h2>
<a class="hg-button hg-button-primary" href="{{AppSubUrl}}/repo/create{{if .ContextUser.IsOrganization}}?org={{.ContextUser.Id}}{{end}}">{{.i18n.Tr "new_repo"}}</a>
</div>
<ul class="hg-repository-results">{{range .Repos}}<li>
<a href="{{AppSubUrl}}/{{$.ContextUser.Name}}/{{.Name}}">
<strong>{{.Name}}</strong>
</a>{{if .IsPrivate}} <span class="hg-badge">{{$.i18n.Tr "ui.private"}}</span>{{end}}<p>{{.Description}}</p>
</li>{{else}}<li class="hg-empty">{{.i18n.Tr "ui.no_owned_repositories"}}</li>{{end}}</ul>{{if not .ContextUser.IsOrganization}}<h2>{{.i18n.Tr "home.collaborative_repos"}}</h2>
<ul class="hg-repository-results">{{range .CollaborativeRepos}}<li>
<a href="{{AppSubUrl}}/{{.Owner.Name}}/{{.Name}}">{{.Owner.Name}} / <strong>{{.Name}}</strong>
</a>{{if .IsPrivate}} <span class="hg-badge">{{$.i18n.Tr "ui.private"}}</span>{{end}}</li>{{else}}<li class="hg-empty">{{.i18n.Tr "ui.no_collaborative_repositories"}}</li>{{end}}</ul>{{end}}</section>
<section id="organizations">
<h2>{{.i18n.Tr "home.my_orgs"}}</h2>
<ul class="hg-repository-results">{{range .Orgs}}<li>
<a href="{{AppSubUrl}}/org/{{.Name}}">{{.Name}}</a>
</li>{{else}}<li class="hg-empty">{{.i18n.Tr "ui.no_organizations"}}</li>{{end}}</ul>
</section>
</div>
</div>{{template "shared/end" .}}
