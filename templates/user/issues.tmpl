{{template "shared/start" .}}<h1>{{.i18n.Tr "ui.issues"}}</h1>
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.state"}}"><a href="?type={{.ViewType}}&repoid={{.RepoId}}&labels={{.SelectLabels}}&milestone={{.SelectedMilestone}}&sortType={{.SortType}}"{{if not .IsShowClosed}} aria-current="page"{{end}}>{{.i18n.Tr "ui.open"}} {{.IssueStats.OpenCount}}</a><a href="?type={{.ViewType}}&state=closed&repoid={{.RepoId}}&labels={{.SelectLabels}}&milestone={{.SelectedMilestone}}&sortType={{.SortType}}"{{if .IsShowClosed}} aria-current="page"{{end}}>{{.i18n.Tr "ui.closed"}} {{.IssueStats.ClosedCount}}</a></nav>
<form method="get" class="hg-catalog-filter"><input type="hidden" name="state" value="{{.State}}"><div class="hg-field"><label for="issue-type">{{.i18n.Tr "ui.issue_filter"}}</label><select id="issue-type" name="type"><option value="all"{{if eq .ViewType "all"}} selected{{end}}>{{.i18n.Tr "ui.owned_issues"}} ({{.IssueStats.AllCount}})</option><option value="assigned"{{if eq .ViewType "assigned"}} selected{{end}}>{{.i18n.Tr "ui.assigned_issues"}} ({{.IssueStats.AssignCount}})</option><option value="created_by"{{if eq .ViewType "created_by"}} selected{{end}}>{{.i18n.Tr "ui.created_issues"}} ({{.IssueStats.CreateCount}})</option>{{if .RepoLink}}<option value="mentioned"{{if eq .ViewType "mentioned"}} selected{{end}}>{{.i18n.Tr "ui.mentioned_issues"}} ({{.IssueStats.MentionCount}})</option>{{end}}</select></div>
<div class="hg-field"><label for="issue-repo">{{.i18n.Tr "ui.repository"}}</label><select id="issue-repo" name="repoid"><option value="0">{{.i18n.Tr "ui.all"}}</option>{{range .Repos}}<option value="{{.Id}}"{{if eq $.RepoId .Id}} selected{{end}}>{{.Owner.Name}} / {{.Name}}</option>{{end}}</select></div><button class="hg-button">{{.i18n.Tr "ui.apply_filters"}}</button></form><ul class="hg-issue-list">{{range .Issues}}<li id="issue-{{.Id}}"><div><a class="hg-issue-title" href="{{AppSubUrl}}/{{.Repo.Owner.Name}}/{{.Repo.Name}}/issues/{{.Index}}">{{.Name}}</a> <span class="hg-meta">#{{.Index}}</span></div><div class="hg-issue-labels">{{range .Labels}}<span class="hg-label" data-label-color="{{.Color}}">{{.Name}}</span>{{end}}</div><p class="hg-meta"><a href="{{AppSubUrl}}/{{.Repo.Owner.Name}}/{{.Repo.Name}}/issues">{{.Repo.Owner.Name}} / {{.Repo.Name}}</a> &middot; <a href="{{AppSubUrl}}/{{.Poster.Name}}">{{.Poster.Name}}</a> &middot; {{TimeSince .Created $.Lang}} &middot; {{.NumComments}} {{$.i18n.Tr "ui.comments"}}</p></li>{{else}}<li class="hg-empty">{{.i18n.Tr "ui.no_issues"}}</li>{{end}}</ul>
{{template "shared/pagination" .IssuePagination}}
<script defer src="{{AppSubUrl}}/js/app/issues.js"></script>
{{template "shared/end" .}}
