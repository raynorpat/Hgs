{{template "shared/start" .}}
<div class="hg-account-page">

<div class="">
    <div id="user-profile-page" class="">
        <div class="">
            <div>
                {{if and .SignedUser (eq .SignedUser.Id .Owner.Id)}}<a href="{{AppSubUrl}}/user/settings" id="profile-avatar">{{end}}
                <img data-avatar-fallback="{{AppSubUrl}}/img/avatar_default.jpg" class="profile-avatar" width="160" height="160" src="{{.Owner.AvatarLink}}" alt="{{.Owner.Name}}">
                {{if and .SignedUser (eq .SignedUser.Id .Owner.Id)}}</a>{{end}}
                <div class="text-center" id="profile-name">
                    {{if .Owner.FullName}}<span id="profile-fullname" class="center-block">{{.Owner.FullName}}</span><br>{{end}}
                    <span class="center-block" id="profile-username">{{.Owner.Name}}</span>
                </div>
            </div>
            <div class="profile-info">
                <hr>
                <ul class="list-no-style">
                    {{if .Owner.Location}}
                    <li class="list-group-item">&nbsp;&nbsp;{{.Owner.Location}}</li>
                    {{end}}
                    {{if .Owner.Email}}
                    <li class="list-group-item">&nbsp;&nbsp;<a href="mailto:{{.Owner.Email}}" rel="nofollow">{{.Owner.Email}}</a></li>
                    {{end}}
                    {{if .Owner.Website}}
                    <li class="list-group-item">&nbsp;&nbsp;<a target="_blank" href="{{.Owner.Website}}">{{.Owner.Website}}</a></li>
                    {{end}}
                    <li class="list-group-item">&nbsp;&nbsp;{{.i18n.Tr "user.join_on"}} {{DateFormat .Owner.Created "M d, Y"}}</li>
                </ul>
                <hr>
                <ul class="list-no-style">
                    <li class="list-group-item profile-rel">
                        <div>
                            <strong>{{.Owner.NumFollowers}}</strong>
                            <p>{{.i18n.Tr "user.followers"}}</p>
                        </div>
                    </li>
                    <li class="list-group-item profile-rel">
                        <div>
                            <strong>{{.Owner.NumStars}}</strong>
                            <p>{{.i18n.Tr "user.starred"}}</p>
                        </div>
                    </li>
                    <li class="list-group-item profile-rel">
                        <div>
                            <strong>{{.Owner.NumFollowings}}</strong>
                            <p>{{.i18n.Tr "user.following"}}</p>
                        </div>
                    </li>
                </ul>
                <hr>
            </div>
        </div>
        <div class="">
            <div id="profile-body">
                <ul class="menu hg-tabs" id="profile-header">
                    <li>
                        <a {{if not .TabName}}class="current"{{end}} href="{{.Owner.HomeLink}}"> {{.i18n.Tr "user.repositories"}}</a>
                    </li>
                    <li>
                        <a {{if eq .TabName "activity"}}class="current"{{end}} href="{{.Owner.HomeLink}}?tab=activity"> {{.i18n.Tr "user.activity"}}</a>
                    </li>
                </ul>
                <div class="tab-content">
                    {{if eq .TabName "activity"}}
                    <div class="tab-pane active" id="dashboard-news">
                    <br>
                    {{template "user/dashboard/feeds" .}}
                    </div>
                    {{else}}
                    <div class="tab-pane active">
                        <div id="org-repo-list">
                            {{range .Repos}}
                                {{if or (not .IsPrivate) (.HasAccess $.SignedUserName)}}
                                <div class="org-repo-item">
                                    <ul class="org-repo-status">
                                        <li> {{.NumStars}}</li>
                                    </ul>
                                    <h2>
                                        <a href="{{AppSubUrl}}/{{$.Owner.Name}}/{{.Name}}">{{.Name}}</a>
                                        {{if .IsPrivate}}
                                        <span class="text-gold"></span>
                                        {{end}}
                                    </h2>
                                    <p class="org-repo-description">{{.Description}}</p>
                                    <p class="org-repo-updated">{{$.i18n.Tr "org.repo_updated"}} {{TimeSince .Updated $.i18n.Lang}}</p>
                                </div>
                                {{end}}
                            {{end}}
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
