{{template "shared/start" .}}
<div class="hg-profile-page">
{{template "shared/profile_header" .}}
{{template "shared/profile_readme" .}}
{{template "shared/profile_tabs" .}}
<div class="hg-profile-columns"><div class="hg-profile-main">
{{template "shared/profile_repositories" .}}
{{if or (eq .Profile.Tab "overview") (eq .Profile.Tab "activity")}}{{template "shared/contribution_calendar" .}}{{template "shared/contribution_activity" .}}{{end}}
{{if eq .Profile.Tab "people"}}{{template "shared/profile_people" .}}{{end}}
</div></div></div>
<script src="{{AppSubUrl}}/js/app/profile.js" defer></script>
{{template "shared/end" .}}
