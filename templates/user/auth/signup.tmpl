{{template "shared/start" .}}
<div class="hg-account-page hg-auth-page">

<div id="sign-wrapper">
    <form class="hg-form hg-panel sign-panel sign-form" id="sign-up-form" action="{{AppSubUrl}}/user/sign_up" method="post" data-prevent-duplicate>{{$.CsrfTokenHtml}}
        <div class="hg-panel-heading">
            <h1>{{if .IsSocialLogin}}{{.i18n.Tr "social_sign_in" | Str2html}}{{else}}{{.i18n.Tr "ui.create_account"}}{{end}}</h1>
        </div>
        <div class="hg-panel-body">

            {{if .DisableRegistration}}
            <p>{{.i18n.Tr "auth.disable_register_prompt"}}</p>
            {{else}}
            <div class="hg-field">
                <label class="req" for="username">{{.i18n.Tr "username"}}</label>
                <input  id="username" name="uname" type="text" autocomplete="username" value="{{.uname}}" required {{if .Err_UserName}}aria-invalid="true" aria-describedby="username-error"{{end}}>{{if .Err_UserName}}<span class="hg-field-error" id="username-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <div class="hg-field">
                <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                <input  id="email" name="email" type="email" autocomplete="email" value="{{.email}}" required  {{if .Err_Email}}aria-invalid="true" aria-describedby="email-error"{{end}}>{{if .Err_Email}}<span class="hg-field-error" id="email-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <div class="hg-field">
                <label class="req" for="password">{{.i18n.Tr "password"}}</label>
                <input  id="password" name="password" type="password" autocomplete="new-password" required {{if .Err_Password}}aria-invalid="true" aria-describedby="password-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="password-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <div class="hg-field">
                <label class="req" for="re-type">{{.i18n.Tr "re_type"}}</label>
                <input  id="re-type" name="retype" type="password" autocomplete="new-password" required {{if .Err_Password}}aria-invalid="true" aria-describedby="re-type-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="re-type-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <div class="hg-field">
                {{.Captcha.CreateHtml}}
            </div>
            <div class="hg-field">
                <label class="req" for="captcha">{{.i18n.Tr "captcha"}}</label>
                <input  id="captcha" name="captcha" type="text" required {{if .Err_Captcha}}aria-invalid="true" aria-describedby="captcha-error"{{end}}>{{if .Err_Captcha}}<span class="hg-field-error" id="captcha-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <div class="hg-field">
                <span class="form-label"></span>
                <button class="hg-button hg-button-primary">{{.i18n.Tr "auth.create_new_account"}}</button>
            </div>
            <div class="hg-field">
                <span class="form-label"></span>
                <a href="{{AppSubUrl}}/user/login">{{if .IsSocialLogin}}{{.i18n.Tr "auth.social_register_hepler_msg"}}{{else}}{{.i18n.Tr "auth.register_hepler_msg"}}{{end}}</a>
            </div>
            {{end}}
        </div>
    </form>
</div>
</div>
{{template "shared/end" .}}
