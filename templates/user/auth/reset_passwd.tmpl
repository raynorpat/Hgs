{{template "shared/start" .}}
<div class="hg-account-page hg-auth-page">

<div id="sign-wrapper">
    <form class="hg-form hg-panel sign-panel sign-form" id="sign-up-form" action="{{AppSubUrl}}/user/reset_password?code={{.Code}}" method="post" data-prevent-duplicate>
        {{.CsrfTokenHtml}}
        <div class="hg-panel-heading">
            <h1>{{.i18n.Tr "auth.reset_password"}}</h1>
        </div>
        <div class="hg-panel-body">

            {{if .IsResetForm}}
            <div class="hg-field">
                <label class="req" for="password">{{.i18n.Tr "password"}}</label>
                <input  id="password" name="password" type="password" required {{if .Err_Password}}aria-invalid="true" aria-describedby="password-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="password-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <hr/>
            <button class="hg-button hg-button-primary">{{.i18n.Tr "auth.reset_password_helper"}}</button>
            {{else}}
            <p>{{.i18n.Tr "auth.invalid_code"}}</p>
            {{end}}
        </div>
    </form>
</div>
</div>
{{template "shared/end" .}}
