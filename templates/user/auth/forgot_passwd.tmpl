{{template "shared/start" .}}
<div class="hg-account-page hg-auth-page">

<div id="sign-wrapper">
    <form class="hg-form hg-panel sign-panel sign-form" id="sign-up-form" action="{{AppSubUrl}}/user/forget_password" method="post" data-prevent-duplicate>
        {{.CsrfTokenHtml}}
        <div class="hg-panel-heading">
            <h1>{{.i18n.Tr "auth.forgot_password"}}</h1>
        </div>
        <div class="hg-panel-body">

            {{if .IsResetSent}}
            <p>{{.i18n.Tr "auth.confirmation_mail_sent_prompt" .Email .Hours | Str2html}}</p>
            <hr/>
            <a class="hg-button hg-button-primary " href="http://{{Mail2Domain .Email}}">{{.i18n.Tr "auth.sign_in_email"}}</a>
            {{else if .IsResetRequest}}
            <div class="hg-field">
                <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                <input  id="email" name="email" type="email"  value="{{.email}}" required {{if .Err_Email}}aria-invalid="true" aria-describedby="email-error"{{end}}>{{if .Err_Email}}<span class="hg-field-error" id="email-error">{{.Flash.ErrorMsg}}</span>{{end}}
            </div>
            <hr/>
            <button class="hg-button hg-button-primary">{{.i18n.Tr "auth.send_reset_mail"}}</button>
            {{else if .IsResetDisable}}
            <p>{{.i18n.Tr "auth.disable_register_mail"}}</p>
            {{else if .ResendLimited}}
            <p>{{.i18n.Tr "auth.resent_limit_prompt"}}</p>
            {{end}}
        </div>
    </form>
</div>
</div>
{{template "shared/end" .}}
