{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="setting-wrapper" class="">
    <div id="user-profile-setting" class="">
        {{template "user/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="user-email-setting-content">
                    <div id="user-email-panel" class="hg-panel">
                        <div class="hg-panel-heading">
                             <strong>{{.i18n.Tr "settings.manage_emails"}}</strong>
                        </div>
                        <ul class="hg-panel-body hg-account-list">
                            <li>{{.i18n.Tr "settings.email_desc"}}</li>
                            {{range .Emails}}
                            <li class="email">
                                <div class="email-content">
                                    <p><strong>{{.Email}}</strong> {{if .IsPrimary}} <span class="email-primary">{{$.i18n.Tr "settings.primary"}}</span> {{end}}</p>
                               </div>
                               {{if not .IsPrimary}}
                               {{if .IsActivated}}
                               <form action="{{AppSubUrl}}/user/settings/email" method="post" data-prevent-duplicate>
                                    {{$.CsrfTokenHtml}}
                                    <input name="_method" type="hidden" value="PRIMARY">
                                    <input name="id" type="hidden" value="{{.Id}}">
                                    <button class="email-btn hg-button hg-button-primary">{{$.i18n.Tr "settings.primary_email"}}</button>
                                </form>
                                {{end}}
                                <form action="{{AppSubUrl}}/user/settings/email" method="post" data-prevent-duplicate>
                                    {{$.CsrfTokenHtml}}
                                    <input name="_method" type="hidden" value="DELETE">
                                    <input name="id" type="hidden" value="{{.Id}}">
                                    <button data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}" class="email-btn hg-button hg-button-danger">{{$.i18n.Tr "settings.delete_email"}}</button>
                                </form>
                               {{end}}
                            </li>
                            {{end}}
                        </ul>
                        <div class="hg-panel-heading">
                             <strong>{{.i18n.Tr "settings.add_new_email"}}</strong>
                        </div>
                        <form class="hg-form hg-panel-body" id="add-email-form" action="{{AppSubUrl}}/user/settings/email" method="post" data-prevent-duplicate>
                            {{.CsrfTokenHtml}}
                            <p class="hg-field">
                                <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                                <input class="" id="email" name="email" value="{{.email}}" type="email" required />
                            </p>
                            <p class="hg-field">
                                <button class="hg-button hg-button-primary" id="email-add-btn">{{.i18n.Tr "settings.add_email"}}</button>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
