{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="setting-wrapper" class="">
    <div id="user-profile-setting" class="">
        {{template "user/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="setting-content">
                    <div id="user-profile-setting-content" class="hg-panel">
                        <div class="hg-panel-heading">
                            <strong>{{.i18n.Tr "settings.public_profile"}}</strong>
                        </div>
                        <div class="hg-panel-body">
                            <form class="hg-form" id="user-profile-form" action="{{AppSubUrl}}/user/settings" method="post" data-rename-field="uname" data-original-name="{{.SignedUser.Name}}" data-confirm-message="{{.i18n.Tr "settings.change_username_desc"}}" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <div class="text-center hg-meta">{{.i18n.Tr "settings.profile_desc"}}</div>
                                <div class="hg-field">
                                    <label>{{.i18n.Tr "settings.uid"}}</label>
                                    <label class="text-left">{{.SignedUser.Id}}</label>
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="username">{{.i18n.Tr "username"}}</label>
                                    <input  id="username" name="uname" type="text" value="{{if .HasError}}{{.uname}}{{else}}{{.SignedUser.Name}}{{end}}" data-uname="{{.SignedUser.Name}}" required  {{if .Err_UserName}}aria-invalid="true" aria-describedby="username-error"{{end}}>{{if .Err_UserName}}<span class="hg-field-error" id="username-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>

                                <div class="hg-field">
                                    <label for="full-name">{{.i18n.Tr "settings.full_name"}}</label>
                                    <input  id="full-name" name="fullname" type="text" value="{{if .HasError}}{{.fullname}}{{else}}{{.SignedUser.FullName}}{{end}}"  {{if .Err_FullName}}aria-invalid="true" aria-describedby="full-name-error"{{end}}>{{if .Err_FullName}}<span class="hg-field-error" id="full-name-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                                    <input  id="email" name="email" type="email" value="{{if .HasError}}{{.email}}{{else}}{{.SignedUser.Email}}{{end}}" required  {{if .Err_Email}}aria-invalid="true" aria-describedby="email-error"{{end}}>{{if .Err_Email}}<span class="hg-field-error" id="email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label for="website">{{.i18n.Tr "settings.website"}}</label>
                                    <input  id="website" name="website" type="url" value="{{if .HasError}}{{.website}}{{else}}{{.SignedUser.Website}}{{end}}"  {{if .Err_Website}}aria-invalid="true" aria-describedby="website-error"{{end}}>{{if .Err_Website}}<span class="hg-field-error" id="website-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label for="location">{{.i18n.Tr "settings.location"}}</label>
                                    <input  id="location" name="location" type="text" value="{{if .HasError}}{{.location}}{{else}}{{.SignedUser.Location}}{{end}}"  {{if .Err_Location}}aria-invalid="true" aria-describedby="location-error"{{end}}>{{if .Err_Location}}<span class="hg-field-error" id="location-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <label class="req" for="gravatar-email">Gravatar {{.i18n.Tr "email"}}</label>
                                    <input  id="gravatar-email" name="avatar" type="text" value="{{if .HasError}}{{.avatar}}{{else}}{{.SignedUser.AvatarEmail}}{{end}}"  {{if .Err_Avatar}}aria-invalid="true" aria-describedby="gravatar-email-error"{{end}}>{{if .Err_Avatar}}<span class="hg-field-error" id="gravatar-email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                                </div>
                                <div class="hg-field">
                                    <button class="hg-button hg-button-primary" id="change-username-btn">{{.i18n.Tr "settings.update_profile"}}</button>
                                </div>
                            </form>
                            <hr>
                            <form class="hg-form" id="user-avatar-form" action="{{AppSubUrl}}/user/settings/avatar" method="post" enctype="multipart/form-data" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <div class="hg-field">
                                    <label for="enable">{{.i18n.Tr "settings.enable_custom_avatar"}}</label>
                                    <input class="" id="enable" name="enable" type="checkbox" {{if .SignedUser.UseCustomAvatar}}checked{{end}} />
                                    <span>{{.i18n.Tr "settings.enable_custom_avatar_helper"}}</span>
                                </div>
                                <div class="hg-field">
                                    <label>{{.i18n.Tr "settings.choose_new_avatar"}}</label>
                                    <input id="avatar-file" name="avatar" type="file" />
                                </div>
                                <div class="hg-field">
                                    <button class="hg-button hg-button-primary">{{.i18n.Tr "settings.update_avatar"}}</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
