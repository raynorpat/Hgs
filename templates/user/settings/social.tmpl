{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="setting-wrapper" class="">
    <div id="user-profile-setting" class="">
        {{template "user/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="setting-content">
                    <div id="user-social-panel" class="hg-panel">
                        <div class="hg-panel-heading"><strong>{{.i18n.Tr "settings.manage_social"}}</strong></div>
                        <ul class="hg-panel-body hg-account-list">
                            <li>{{.i18n.Tr "settings.social_desc"}}</li>
                            {{range .Socials}}
                            <li class="ssh">
                                <span class="active-icon label label-{{if .HasRecentActivity}}green{{else}}gray{{end}} label-radius"></span>

                                <div class="ssh-content">
                                    <p><strong>{{Oauth2Name .Type}}</strong></p>
                                    <p class="print">{{.Identity}}</p>
                                    <p class="activity"><i>{{$.i18n.Tr "settings.add_on"}} <span title="{{DateFormat .Created "r"}}">{{DateFormat .Created "M d, Y"}}</span> —  {{$.i18n.Tr "settings.last_used"}} {{DateFormat .Updated "M d, Y"}}</i></p>
                                </div>
                                <form class="hg-inline-form" method="post" action="{{AppSubUrl}}/user/settings/social?remove={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "settings.unbind"}}</button></form>
                            </li>
                            {{end}}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
