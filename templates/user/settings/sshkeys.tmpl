{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="setting-wrapper" class="">
    <div id="user-profile-setting" class="">
        {{template "user/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="user-ssh-setting-content">
                    <div id="user-ssh-panel" class="hg-panel">
                        <div class="hg-panel-heading">

                            <strong>{{.i18n.Tr "settings.manage_ssh_keys"}}</strong>
                        </div>
                        <ul class="hg-panel-body hg-account-list">
                            <li>{{.i18n.Tr "settings.ssh_desc"}}</li>
                            {{range .Keys}}
                            <li class="ssh">
                                <span class="active-icon label label-{{if .HasRecentActivity}}green{{else}}gray{{end}} label-radius"></span>

                                <div class="ssh-content">
                                    <p><strong>{{.Name}}</strong></p>
                                    <p class="print">{{.Fingerprint}}</p>
                                    <p class="activity"><i>{{$.i18n.Tr "settings.add_on"}} <span title="{{DateFormat .Created "r"}}">{{DateFormat .Created "M d, Y"}}</span> —  {{if .HasUsed}}{{$.i18n.Tr "settings.last_used"}} <span title="{{DateFormat .Updated "r"}}">{{DateFormat .Updated "M d, Y"}}</span>{{else}}{{$.i18n.Tr "settings.no_activity"}}{{end}}</i></p>
                                </div>
                                <form action="{{AppSubUrl}}/user/settings/ssh" method="post" data-prevent-duplicate>
                                    {{$.CsrfTokenHtml}}
                                    <input name="_method" type="hidden" value="DELETE">
                                    <input name="id" type="hidden" value="{{.Id}}">
                                    <button data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}" class="ssh-btn hg-button hg-button-danger">{{$.i18n.Tr "settings.delete_key"}}</button>
                                </form>
                            </li>
                            {{end}}
                        </ul>
                    </div>
                    <p>{{.i18n.Tr "settings.ssh_helper" "https://help.github.com/articles/generating-ssh-keys" "https://help.github.com/ssh-issues/" | Str2html}}</p>
                    <br>
                    <form class="hg-panel hg-form form-settings-add" id="user-ssh-add-form" action="{{AppSubUrl}}/user/settings/ssh" method="post" data-prevent-duplicate>
                        {{.CsrfTokenHtml}}
                        <p class="hg-panel-heading"><strong>{{.i18n.Tr "settings.add_new_key"}}</strong></p>
                        <div class="hg-panel-body">
                            <p class="hg-field">
                                <label class="req" for="ssh-title">{{.i18n.Tr "settings.key_name"}}</label>
                                <input class="" id="ssh-title" name="title" value="{{.title}}" type="text" required />
                            </p>
                            <p class="hg-field">
                                <label class="req" for="ssh-key">{{.i18n.Tr "settings.key_content"}}</label>
                                <textarea class="" name="content" id="ssh-key" required>{{.content}}</textarea>
                            </p>
                            <p class="hg-field">
                                <button class="hg-button hg-button-primary" id="ssh-add-btn">{{.i18n.Tr "settings.add_key"}}</button>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
