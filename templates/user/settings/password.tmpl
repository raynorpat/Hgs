{{template "shared/start" .}}
<div class="hg-account-page">
<h1>{{.Title}}</h1>

<div id="setting-wrapper" class="">
    <div id="user-profile-setting" class="">
        {{template "user/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="setting-content">
                    <div id="user-profile-setting-content" class="hg-panel">
                        <p class="hg-panel-heading"><strong>{{.i18n.Tr "settings.change_password"}}</strong></p>
                        <form class="hg-form hg-panel-body" id="user-profile-form" action="{{AppSubUrl}}/user/settings/password" method="post" data-prevent-duplicate>
                            {{.CsrfTokenHtml}}
                            <p class="hg-field">
                                <label class="req" for="old-password">{{.i18n.Tr "settings.old_password"}}</label>
                                <input  id="old-password" name="old_password" type="password" required  {{if .Err_OldPassword}}aria-invalid="true" aria-describedby="old-password-error"{{end}}>{{if .Err_OldPassword}}<span class="hg-field-error" id="old-password-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </p>
                            <p class="hg-field">
                                <label class="req" for="password">{{.i18n.Tr "settings.new_password"}}</label>
                                <input  id="password" name="password" type="password" required  {{if .Err_Password}}aria-invalid="true" aria-describedby="password-error"{{end}}>{{if .Err_Password}}<span class="hg-field-error" id="password-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </p>
                            <p class="hg-field">
                                <label class="req" for="retype">{{.i18n.Tr "re_type"}}</label>
                                <input  id="retype" name="retype" type="password" required  {{if .Err_Retype}}aria-invalid="true" aria-describedby="retype-error"{{end}}>{{if .Err_Retype}}<span class="hg-field-error" id="retype-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </p>
                            <p class="hg-field">
                                <span class="form-label"></span>
                                <button class="hg-button hg-button-primary">{{.i18n.Tr "settings.change_password"}}</button>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
