{{template "ng/base/head" .}}
{{template "ng/base/header" .}}
<div id="repo-wrapper">{{template "repo/header" .}}<div class="container clear">
 <div class="panel panel-radius"><div class="panel-header"><strong>{{.Changeset.User}}</strong> · {{ShortSha .Node}} · {{TimeSince .Changeset.Date .Lang}} <a href="{{.SourceURL}}">{{.i18n.Tr "repo.hg_source"}}</a></div>
 <div class="panel-content"><p>{{.Changeset.Message}}</p>
 {{range $i,$parent := .Parents}}<p>{{$.i18n.Tr "repo.hg_parent"}} {{$i}}: <a href="{{$.RepoLink}}/commit/{{$parent}}">{{$parent}}</a> <a href="{{$.RepoLink}}/commit/{{$.Node}}?parent={{$i}}">{{$.i18n.Tr "repo.hg_compare_parent"}}</a>{{if eq $i $.SelectedParent}} ✓{{end}}</p>{{end}}
 {{if .DiffTruncated}}<p>{{.i18n.Tr "repo.hg_diff_truncated"}}</p>{{end}}{{if .DiffBinary}}<p>{{.i18n.Tr "repo.hg_diff_binary"}}</p>{{end}}
 <pre class="diff">{{.Patch}}</pre></div></div>
 </div></div>
{{template "ng/base/footer" .}}
