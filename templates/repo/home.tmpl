{{template "shared/start" .}}
{{template "repo/header" .}}
<p class="hg-description">{{.Repository.DescriptionHtml}}{{if .Repository.Website}} <a href="{{.Repository.Website}}">{{.Repository.Website}}</a>{{end}}</p>
<div class="hg-source-navigation">{{template "shared/revision_selector" .}}<nav class="hg-breadcrumb" aria-label="{{.i18n.Tr "ui.path"}}">
<a href="{{.SourceURL}}">{{.Repository.Name}}</a>{{range .Breadcrumbs}} / <a href="{{.URL}}">{{.Name}}</a>{{end}}</nav>
</div>
{{if .IsFile}}{{template "repo/view_file" .}}{{else}}{{template "repo/view_list" .}}{{end}}
{{template "shared/end" .}}
