{{template "shared/start" .}}{{template "repo/header" .}}<div class="hg-pull-page">
<header class="hg-page-header"><div><p><a href="{{.RepoLink}}/pulls">{{.i18n.Tr "ui.pull_requests"}}</a> / #{{.Pull.Pull.Number}}</p><h2>{{.Pull.Pull.Title}}</h2><p><span class="hg-badge hg-status-{{.Pull.Pull.State}}">{{.i18n.Tr (printf "pulls.%s" .Pull.Pull.State)}}</span> {{.Pull.Row.Source}} · {{.Pull.Source.Ref.Kind}}: {{.Pull.Source.Ref.Name}} → {{.Pull.Row.Target}} · {{.Pull.Target.Ref.Kind}}: {{.Pull.Target.Ref.Name}}</p></div></header>
{{if .PullError}}<p class="hg-alert hg-alert-danger" role="alert">{{.PullError}}</p>{{end}}
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.pull_requests"}}"><a href="#conversation">{{.i18n.Tr "pulls.conversation"}}</a><a href="#changesets">{{.i18n.Tr "pulls.changesets"}}</a><a href="#files">{{.i18n.Tr "pulls.files"}}</a></nav>
<section class="hg-panel" aria-label="{{.i18n.Tr "pulls.comparison"}}"><h3>{{.i18n.Tr "pulls.comparison"}}</h3><p role="status" data-pull-state="{{.Pull.Status}}">{{.i18n.Tr (printf "pulls.status_%s" .Pull.Status)}}</p>{{if .Pull.Comparison.ID}}<p class="hg-meta">{{.i18n.Tr "pulls.pins"}}</p><dl><dt>{{.i18n.Tr "pulls.source"}}</dt><dd><code>{{.Pull.Comparison.SourceNode}}</code></dd><dt>{{.i18n.Tr "pulls.target"}}</dt><dd><code>{{.Pull.Comparison.TargetNode}}</code></dd></dl>{{end}}
{{if and .IsSigned (not .Pull.Pull.SourceDeleted) (ne .Pull.Pull.State "merged")}}<form method="post" action="{{.Pull.Row.URL}}/refresh" data-prevent-duplicate>{{.CsrfTokenHtml}}<button class="hg-button">{{.i18n.Tr "pulls.refresh"}}</button></form>{{end}}
{{if .Pull.OperationURL}}<p><a href="{{.Pull.OperationURL}}" data-pull-operation="{{.Pull.OperationURL}}" data-operation-state="{{.Pull.Operation.State}}">{{.i18n.Tr "pulls.check_operation"}}</a></p><p class="hg-meta">{{.i18n.Tr "pulls.operation_help"}}</p>{{end}}
{{if .Pull.CanSelect}}<details><summary>{{.i18n.Tr "pulls.reselect"}}</summary><form method="post" action="{{.Pull.Row.URL}}/refresh" data-prevent-duplicate>{{.CsrfTokenHtml}}<input type="hidden" name="expected_source" value="{{.Pull.Pull.SourceSelection}}"><input type="hidden" name="expected_target" value="{{.Pull.Pull.TargetSelection}}"><input type="hidden" name="comparison_id" value="{{.Pull.Pull.CurrentComparisonID}}"><input type="hidden" name="target_kind" value="{{.Pull.Target.Ref.Kind}}"><input type="hidden" name="target_name" value="{{.Pull.Target.Ref.Name}}">
{{if .Pull.CanSelectSource}}<div class="hg-field"><label for="reselect-kind">{{.i18n.Tr "pulls.ref_kind"}}</label><select id="reselect-kind" name="source_kind"><option value="branch"{{if eq .Pull.Form.SourceKind "branch"}} selected{{end}}>{{.i18n.Tr "pulls.branch"}}</option><option value="bookmark"{{if eq .Pull.Form.SourceKind "bookmark"}} selected{{end}}>{{.i18n.Tr "pulls.bookmark"}}</option><option value="tag"{{if eq .Pull.Form.SourceKind "tag"}} selected{{end}}>{{.i18n.Tr "pulls.tag"}}</option><option value="node"{{if eq .Pull.Form.SourceKind "node"}} selected{{end}}>{{.i18n.Tr "pulls.node"}}</option></select></div><div class="hg-field"><label for="reselect-source">{{.i18n.Tr "pulls.source"}}</label><input id="reselect-source" name="source_name" value="{{.Pull.Form.SourceName}}" required maxlength="4096"></div><div class="hg-field"><label for="reselect-source-head">{{.i18n.Tr "pulls.head"}}</label><input id="reselect-source-head" name="source_head" value="{{.Pull.Form.SourceHead}}" maxlength="40"></div>{{else}}<input type="hidden" name="source_kind" value="{{.Pull.Source.Ref.Kind}}"><input type="hidden" name="source_name" value="{{.Pull.Source.Ref.Name}}"><input type="hidden" name="source_head" value="{{.Pull.Source.Head}}">{{end}}
<div class="hg-field"><label for="reselect-target-head">{{.i18n.Tr "pulls.target_head"}}</label><input id="reselect-target-head" name="target_head" value="{{.Pull.Form.TargetHead}}" maxlength="40"></div><p>{{.i18n.Tr "pulls.reselect_help"}}</p><button class="hg-button">{{.i18n.Tr "pulls.save_refresh"}}</button></form></details>{{end}}</section>
{{template "repo/pull/conversation" .}}{{template "repo/pull/reviewers" .}}{{template "repo/pull/changesets" .}}{{template "repo/pull/files" .}}
{{if .Pull.CanMerge}}<section class="hg-panel"><h3>{{.i18n.Tr "pulls.merge"}}</h3><form method="post" action="{{.Pull.Row.URL}}/merge" data-prevent-duplicate data-pull-merge>{{.CsrfTokenHtml}}<input type="hidden" name="comparison_id" value="{{.Pull.Comparison.ID}}"><input type="hidden" name="source_node" value="{{.Pull.Comparison.SourceNode}}"><input type="hidden" name="target_node" value="{{.Pull.Comparison.TargetNode}}"><input type="hidden" name="merge_key" value="{{.Pull.MergeKey}}"><p>{{.Pull.Strategy}}</p><p>{{.Pull.Row.Source}} <code>{{.Pull.Comparison.SourceNode}}</code> → {{.Pull.Row.Target}} <code>{{.Pull.Comparison.TargetNode}}</code></p><label><input type="checkbox" name="confirm" value="true" required> {{.i18n.Tr "pulls.confirm"}}</label><p><button class="hg-button hg-button-primary">{{.i18n.Tr "pulls.merge"}}</button></p></form></section>{{end}}
{{if and .Pull.Comparison.SnapshotComplete (not .Pull.Pull.SourceDeleted)}}<details id="local-resolution"><summary>{{.i18n.Tr "pulls.local"}}</summary><p>{{.i18n.Tr "pulls.local_help"}}</p><pre><code>hg clone "{{.Pull.TargetClone}}" review-work
cd review-work
hg pull "{{.Pull.SourceClone}}"
hg update -r {{.Pull.Comparison.TargetNode}}
hg merge -r {{.Pull.Comparison.SourceNode}}
hg resolve --list</code></pre><p>{{.i18n.Tr "pulls.local_finish"}}</p></details>{{end}}</div>
<script defer src="{{AppSubUrl}}/js/app/pulls.js"></script>{{template "shared/end" .}}
