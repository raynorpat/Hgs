<section id="conversation"><h3>{{.i18n.Tr "pulls.conversation"}}</h3><article class="hg-panel"><a class="hg-inline-person" href="{{AppSubUrl}}/{{.Pull.Row.Author}}">{{template "shared/avatar" (Avatar .Pull.Row.Avatar .Pull.Row.Author 28)}}{{.Pull.Row.Author}}</a><div class="hg-markdown">{{.Pull.Body}}</div></article>
{{if .Pull.CanEdit}}<details><summary>{{.i18n.Tr "pulls.edit"}}</summary><form method="post" action="{{.Pull.Row.URL}}/edit" data-prevent-duplicate data-editor-draft="pull_edit" data-draft-destination="{{.Pull.Row.URL}}" data-draft-item="{{.Pull.Pull.ID}}" data-draft-title="{{.Pull.Pull.Title}}" data-draft-body="{{.Pull.Pull.Body}}" autocomplete="off">{{template "shared/editor_draft_controls" .}}{{.CsrfTokenHtml}}<div class="hg-field"><label for="edit-title">{{.i18n.Tr "ui.title"}}</label><input id="edit-title" name="title" value="{{.Pull.Form.Title}}" required maxlength="255"></div>{{template "shared/markdown_editor" .PullEditor}}<button class="hg-button">{{.i18n.Tr "pulls.save"}}</button></form></details>{{end}}
{{range .Pull.Comments}}<article class="hg-panel" id="comment-{{.ID}}"><header><a class="hg-inline-person" href="{{AppSubUrl}}/{{.Author}}">{{template "shared/avatar" (Avatar .Avatar .Author 28)}}{{.Author}}</a> <a href="{{.URL}}">#{{.ID}}</a></header>{{if .ComparisonID}}<p><a href="{{.FileURL}}">{{.Path}}</a> · {{.Side}}:{{.Line}} · {{$.i18n.Tr "pulls.comparison"}} {{.ComparisonID}}{{if .Outdated}} <span class="hg-badge">{{$.i18n.Tr "pulls.outdated"}}</span>{{end}}{{if .Resolved}} <span class="hg-badge">{{$.i18n.Tr "pulls.resolved"}}</span>{{end}}</p>{{end}}<div class="hg-markdown">{{.HTML}}</div>{{if and .ComparisonID .CanResolve}}<form method="post" action="{{$.Pull.Row.URL}}/threads/{{.ID}}/resolve" data-prevent-duplicate>{{$.CsrfTokenHtml}}<input type="hidden" name="resolved" value="{{if .Resolved}}false{{else}}true{{end}}"><button class="hg-button">{{if .Resolved}}{{$.i18n.Tr "pulls.reopen_thread"}}{{else}}{{$.i18n.Tr "pulls.resolve"}}{{end}}</button></form>{{end}}</article>{{end}}
{{if and .IsSigned (not .Pull.Pull.SourceDeleted)}}<form method="post" action="{{.Pull.Row.URL}}/comments" data-prevent-duplicate data-editor-draft="pull_comment" data-draft-destination="{{.Pull.Row.URL}}" data-draft-item="{{.Pull.Pull.ID}}" autocomplete="off">{{template "shared/editor_draft_controls" .}}{{.CsrfTokenHtml}}{{template "shared/markdown_editor" .PullCommentEditor}}<details{{if .PullCommentInline}} open{{end}}><summary>{{.i18n.Tr "pulls.inline"}}</summary><p>{{.i18n.Tr "pulls.inline_help"}}</p><div class="hg-field"><label for="comment-comparison">{{.i18n.Tr "pulls.comparison"}}</label><input id="comment-comparison" name="comparison_id" type="number" min="1" value="{{if .PullCommentForm.ComparisonID}}{{.PullCommentForm.ComparisonID}}{{end}}"></div><div class="hg-field"><label for="comment-path">{{.i18n.Tr "pulls.path"}}</label><input id="comment-path" name="path" maxlength="4096" value="{{.PullCommentForm.Path}}"></div><div class="hg-field"><label for="comment-side">{{.i18n.Tr "pulls.side"}}</label><select id="comment-side" name="side"><option value="">—</option><option value="base"{{if eq .PullCommentForm.Side "base"}} selected{{end}}>{{.i18n.Tr "pulls.base"}}</option><option value="source"{{if eq .PullCommentForm.Side "source"}} selected{{end}}>{{.i18n.Tr "pulls.source"}}</option></select></div><div class="hg-field"><label for="comment-line">{{.i18n.Tr "pulls.line"}}</label><input id="comment-line" type="number" name="line" min="1" value="{{if .PullCommentForm.Line}}{{.PullCommentForm.Line}}{{end}}"></div></details><button class="hg-button hg-button-primary">{{.i18n.Tr "pulls.comment"}}</button></form>{{end}}
{{if .Pull.CanState}}<form method="post" action="{{.Pull.Row.URL}}/state" data-prevent-duplicate>{{.CsrfTokenHtml}}<input type="hidden" name="state" value="{{if eq .Pull.Pull.State "open"}}declined{{else}}open{{end}}"><button class="hg-button">{{if eq .Pull.Pull.State "open"}}{{.i18n.Tr "pulls.decline"}}{{else}}{{.i18n.Tr "pulls.reopen"}}{{end}}</button></form>{{end}}</section>
