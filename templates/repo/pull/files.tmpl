<section id="files"><h3>{{.i18n.Tr "pulls.files"}}</h3><p>{{.i18n.Tr "pulls.diff_help"}}</p>{{if .Pull.Binary}}<p class="hg-alert hg-alert-info">{{.i18n.Tr "pulls.binary"}}</p>{{end}}{{if .Pull.Truncated}}<p class="hg-alert hg-alert-info">{{.i18n.Tr "pulls.truncated"}}</p>{{end}}<pre class="hg-pull-diff"><code>{{.Pull.Diff}}</code></pre>{{if .Pull.Comparison.SnapshotComplete}}<form method="get" action="{{.Pull.Row.URL}}/comparisons/{{.Pull.Comparison.ID}}/files/"><div class="hg-field"><label for="download-path">{{.i18n.Tr "pulls.path"}}</label><input id="download-path" name="path" required maxlength="4096"></div><div class="hg-field"><label for="download-side">{{.i18n.Tr "pulls.side"}}</label><select id="download-side" name="side"><option value="source">{{.i18n.Tr "pulls.source"}}</option><option value="base">{{.i18n.Tr "pulls.base"}}</option><option value="target">{{.i18n.Tr "pulls.target"}}</option></select></div><button class="hg-button">{{.i18n.Tr "pulls.download"}}</button></form>{{end}}</section>
