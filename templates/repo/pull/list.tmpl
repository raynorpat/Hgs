{{template "shared/start" .}}
{{if .Repository}}{{template "repo/header" .}}{{end}}
<header class="hg-page-header"><h2>{{.i18n.Tr "ui.pull_requests"}}</h2>{{if and .Repository .IsSigned}}<a class="hg-button hg-button-primary" href="{{.PullRoot}}/new">{{.i18n.Tr "pulls.create"}}</a>{{end}}</header>
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.state"}}">{{range .PullTabs}}<a href="{{.URL}}"{{if .Active}} aria-current="page"{{end}}>{{.Label}} <span>{{.Count}}</span></a>{{end}}</nav>
<form method="get" class="hg-catalog-filter"><input type="hidden" name="state" value="{{.PullState}}"><div class="hg-field"><label for="pull-filter">{{.i18n.Tr "pulls.filter"}}</label><select id="pull-filter" name="filter"><option value="all">{{.i18n.Tr "pulls.all"}}</option><option value="needs_review"{{if eq .PullFilter "needs_review"}} selected{{end}}>{{.i18n.Tr "pulls.needs_review"}}</option><option value="created"{{if eq .PullFilter "created"}} selected{{end}}>{{.i18n.Tr "pulls.created"}}</option><option value="assigned"{{if eq .PullFilter "assigned"}} selected{{end}}>{{.i18n.Tr "pulls.assigned"}}</option></select></div><button class="hg-button">{{.i18n.Tr "ui.apply_filters"}}</button></form>
<ul class="hg-issue-list">{{range .PullRows}}<li><a class="hg-issue-title" href="{{.URL}}">{{.Title}}</a> <span class="hg-meta">#{{.Number}}</span> <span class="hg-badge hg-status-{{.State}}">{{$.i18n.Tr (printf "pulls.%s" .State)}}</span><p>{{.Source}} → {{.Target}}</p><a class="hg-inline-person" href="{{AppSubUrl}}/{{.Author}}"><img src="{{.Avatar}}" width="28" height="28" alt="">{{.Author}}</a></li>{{else}}<li><h3>{{.i18n.Tr "pulls.empty"}}</h3><p>{{.i18n.Tr "pulls.empty_help"}}</p></li>{{end}}</ul>
{{template "shared/pagination" .PullPagination}}
{{template "shared/end" .}}
