<section><h3>{{.i18n.Tr "pulls.reviewers"}}</h3><ul class="hg-issue-list">{{range .Pull.Reviewers}}<li><a class="hg-inline-person" href="{{AppSubUrl}}/{{.Name}}"><img src="{{.Avatar}}" width="28" height="28" alt="">{{.Name}}</a> · {{if and .Assigned .Eligible (eq .State "inactive")}}{{$.i18n.Tr "pulls.awaiting_review"}}{{else}}{{$.i18n.Tr (printf "pulls.review_%s" .State)}}{{end}}{{if not .Eligible}} · {{$.i18n.Tr "pulls.ineligible"}}{{end}}{{if .Assigned}} · {{$.i18n.Tr "pulls.assigned"}}{{end}}{{if $.Pull.CanDismiss}}<form method="post" action="{{$.Pull.Row.URL}}/review/dismiss" data-prevent-duplicate>{{$.CsrfTokenHtml}}<input type="hidden" name="reviewer_id" value="{{.ReviewerID}}"><label for="dismiss-{{.ID}}">{{$.i18n.Tr "pulls.reason"}}</label><input id="dismiss-{{.ID}}" name="reason" required maxlength="4096"><button class="hg-button">{{$.i18n.Tr "pulls.dismiss"}}</button></form>{{end}}</li>{{else}}<li>{{.i18n.Tr "pulls.no_reviews"}}</li>{{end}}</ul>
{{if .Pull.CanAssign}}<form method="post" action="{{.Pull.Row.URL}}/reviewers" data-prevent-duplicate>{{.CsrfTokenHtml}}<div class="hg-field"><label for="assign-reviewers">{{.i18n.Tr "pulls.reviewers"}}</label><input id="assign-reviewers" name="reviewers" value="{{.Pull.Form.Reviewers}}" maxlength="4096"><p class="hg-meta">{{.i18n.Tr "pulls.reviewers_help"}}</p></div><button class="hg-button">{{.i18n.Tr "pulls.save"}}</button></form>{{end}}
{{if .Pull.CanReview}}<form method="post" action="{{.Pull.Row.URL}}/review" data-prevent-duplicate>{{.CsrfTokenHtml}}<input type="hidden" name="comparison_id" value="{{.Pull.Comparison.ID}}"><div class="hg-field"><label for="review-state">{{.i18n.Tr "pulls.review"}}</label><select id="review-state" name="state"><option value="approved">{{.i18n.Tr "pulls.approve"}}</option><option value="changes_requested">{{.i18n.Tr "pulls.request_changes"}}</option></select></div><button class="hg-button">{{.i18n.Tr "pulls.submit_review"}}</button></form>{{end}}</section>
