{{template "shared/start" .}}{{template "repo/header" .}}<section class="hg-panel">
<h2>{{.i18n.Tr "repo.quick_guide"}}</h2>
<p>{{.i18n.Tr "ui.empty_repository"}}</p>
<div class="hg-scroll">
<pre>
<code>hg clone {{.CloneLink.HTTPS}}
cd {{.Repository.Name}}
{{.i18n.Tr "repo.hg_add_files"}}
hg add
hg commit -m "first commit"
hg push</code>
</pre>
</div>{{if .IsRepositoryTrueOwner}}<a class="hg-button" href="{{.RepoLink}}/settings">{{.i18n.Tr "repo.settings"}}</a>{{end}}</section>{{template "shared/end" .}}
