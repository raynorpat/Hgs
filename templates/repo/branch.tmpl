{{template "ng/base/head" .}}
{{template "ng/base/header" .}}
<div id="repo-wrapper">{{template "repo/header" .}}<div class="container clear"><div class="panel panel-radius">
 <div class="panel-header"><strong>{{.i18n.Tr "repo.hg_references"}}</strong></div>
 <table class="panel-body table">{{range .References}}<tr><td>{{.Kind}}</td><td><a href="{{.SelectionURL}}">{{.Name}}</a></td><td><a href="{{.URL}}">{{ShortSha .Node}}</a></td><td>{{if .Closed}}{{$.i18n.Tr "repo.hg_closed"}}{{end}}</td></tr>{{end}}</table>
 </div></div></div>
{{template "ng/base/footer" .}}
