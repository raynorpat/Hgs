{{template "shared/start" .}}{{template "repo/header" .}}{{template "repo/settings/nav" .}}<section class="hg-settings">
<h2>{{.i18n.Tr "repo.settings.collaboration"}}</h2>
<ul class="hg-members">{{range .Collaborators}}<li>
<a href="{{AppSubUrl}}/{{.Name}}">
{{template "shared/avatar" (Avatar .AvatarLink .Name 28)}} <strong>{{.Name}}</strong>{{if .FullName}} · {{.FullName}}{{end}}</a>{{if not (eq .Id $.Owner.Id)}}<form action="{{$.RepoLink}}/settings/collaboration" method="post" data-prevent-duplicate>{{$.CsrfTokenHtml}}<input type="hidden" name="remove" value="{{.Name}}">
<button class="hg-button hg-button-danger" type="submit">{{$.i18n.Tr "ui.remove_collaborator"}}</button>
</form>{{end}}</li>{{else}}<li class="hg-empty">{{.i18n.Tr "ui.no_collaborators"}}</li>{{end}}</ul>
<form class="hg-form" action="{{.RepoLink}}/settings/collaboration" method="post" data-prevent-duplicate>
<div class="hg-field">{{.CsrfTokenHtml}}<label for="collaborator">{{.i18n.Tr "repo.settings.add_collaborator"}}</label>
<input id="collaborator" name="collaborator" list="collaborator-matches" data-collaborator-search="{{AppSubUrl}}/api/v1/users/search" autocomplete="off" required>
<datalist id="collaborator-matches">
</datalist>
</div>
<button class="hg-button hg-button-primary" type="submit">{{.i18n.Tr "repo.settings.add_collaborator"}}</button>
</form>
</section>{{template "shared/end" .}}
