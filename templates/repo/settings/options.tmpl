{{template "shared/start" .}}{{template "repo/header" .}}{{template "repo/settings/nav" .}}<section class="hg-settings">
<h2>{{.i18n.Tr "repo.settings.basic_settings"}}</h2>
<form class="hg-form" action="{{.RepoLink}}/settings" method="post" data-prevent-duplicate data-rename-form data-original-name="{{.Repository.Name}}" data-confirm-message="{{.i18n.Tr "repo.settings.change_reponame_desc"}}">{{.CsrfTokenHtml}}<input type="hidden" name="action" value="update">
<div class="hg-field">
<label for="repo_name">{{.i18n.Tr "repo.repo_name"}}</label>
<input id="repo_name" name="repo_name" value="{{.UIRepoName}}" required{{if .Err_RepoName}} aria-invalid="true"{{end}}>
</div>
<div class="hg-field">
<label for="desc">{{.i18n.Tr "repo.repo_desc"}}</label>
<textarea id="desc" name="desc"{{if .Err_Description}} aria-invalid="true"{{end}}>{{.UIRepoDescription}}</textarea>
</div>
<div class="hg-field">
<label for="website">{{.i18n.Tr "repo.settings.site"}}</label>
<input id="website" name="site" type="url" value="{{.UIRepoWebsite}}"{{if .Err_Website}} aria-invalid="true"{{end}}>
</div>
<div class="hg-field">
<label for="visibility">
<input id="visibility" type="checkbox" name="private"{{if .UIRepoPrivate}} checked{{end}}> {{.i18n.Tr "ui.private"}}</label>
<p class="hg-meta">{{.i18n.Tr "repo.visiblity_helper" | Str2html}}</p>
</div>
<button class="hg-button hg-button-primary" type="submit">{{.i18n.Tr "repo.settings.update_settings"}}</button>
</form>
<section class="hg-danger-zone">
<h2>{{.i18n.Tr "repo.settings.danger_zone"}}</h2>
<details>
<summary class="hg-button hg-button-danger">{{.i18n.Tr "repo.settings.transfer"}}</summary>
<p>{{.i18n.Tr "repo.settings.transfer_desc"}}</p>
<div>{{.i18n.Tr "repo.settings.transfer_notices" | Str2html}}</div>
<form class="hg-form" action="{{.RepoLink}}/settings" method="post" data-prevent-duplicate data-confirm-message="{{.i18n.Tr "repo.settings.transfer_desc"}}">{{.CsrfTokenHtml}}<input type="hidden" name="action" value="transfer">
<div class="hg-field">
<label for="transfer-name">{{.i18n.Tr "repo.repo_name"}}</label>
<input id="transfer-name" name="repo_name" required>
</div>
<div class="hg-field">
<label for="new-owner">{{.i18n.Tr "repo.settings.transfer_owner"}}</label>
<input id="new-owner" name="new_owner_name" required>
</div>
<div class="hg-field">
<label for="transfer-password">{{.i18n.Tr "password"}}</label>
<input id="transfer-password" name="password" type="password" autocomplete="current-password" required>
</div>
<button type="submit" class="hg-button hg-button-danger">{{.i18n.Tr "repo.settings.make_transfer"}}</button>
</form>
</details>
<details>
<summary class="hg-button hg-button-danger">{{.i18n.Tr "repo.settings.delete"}}</summary>
<p>{{.i18n.Tr "repo.settings.delete_desc"}}</p>
<form class="hg-form" action="{{.RepoLink}}/settings" method="post" data-prevent-duplicate data-confirm-message="{{.i18n.Tr "repo.settings.delete_desc"}}">{{.CsrfTokenHtml}}<input type="hidden" name="action" value="delete">
<div class="hg-field">
<label for="delete-name">{{.i18n.Tr "repo.repo_name"}}</label>
<input id="delete-name" name="repo_name" required>
</div>
<div class="hg-field">
<label for="delete-password">{{.i18n.Tr "password"}}</label>
<input id="delete-password" name="password" type="password" autocomplete="current-password" required>
</div>
<button type="submit" class="hg-button hg-button-danger">{{.i18n.Tr "repo.settings.confirm_delete"}}</button>
</form>
</details>
</section>
</section>{{template "shared/end" .}}
