<section class="hg-panel" data-node="{{.Node}}" data-path-url="{{.FileLink}}" id="{{if .ReadmeExist}}repo-readme{{else}}repo-read-file{{end}}">
<header class="hg-panel-heading hg-page-header">
<div>
<strong>{{.FileName}}</strong> <span class="hg-meta">{{FileSize .FileSize}}{{if .FileSymlink}} · {{.i18n.Tr "repo.hg_symlink"}}{{end}}</span>
</div>
<div class="hg-actions">{{if not .ReadmeInList}}<a class="hg-button" href="{{.FileHistoryURL}}">{{.i18n.Tr "repo.file_history"}}</a>{{end}}<a class="hg-button" href="{{.FileLink}}">{{.i18n.Tr "repo.file_raw"}}</a>
</div>
</header>
<div class="hg-file-content">

{{if .FileOversized}}<p class="hg-empty">{{.i18n.Tr "repo.hg_oversized"}}</p>{{else if not .IsFileText}}<p class="hg-empty">{{.i18n.Tr "repo.hg_binary"}}</p>{{else if .IsMarkdown}}<div class="hg-markdown">{{.FileContent | Str2html}}</div>{{else}}<div class="hg-scroll" tabindex="0" role="region" aria-label="{{.i18n.Tr "ui.source"}}">
<pre class="prettyprint linenums" data-source-code>
<code>{{.FileContent}}</code>
</pre>
</div>{{end}}</div>
</section>
