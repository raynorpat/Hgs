<div class="panel panel-radius" id="{{if .ReadmeExist}}repo-readme{{else}}repo-read-file{{end}}">
 <p class="panel-header"><strong class="file-name">{{.FileName}}</strong><span class="file-size">{{FileSize .FileSize}}</span>
 {{if .FileSymlink}} · {{.i18n.Tr "repo.hg_symlink"}}{{end}}
 {{if not .ReadmeInList}}<a class="right btn btn-medium btn-gray" href="{{.FileHistoryURL}}">{{.i18n.Tr "repo.file_history"}}</a>{{end}}
 <a class="right btn btn-medium btn-gray" href="{{.FileLink}}">{{.i18n.Tr "repo.file_raw"}}</a></p>
 <div class="panel-content code-view" id="repo-code-view">
 {{if .FileOversized}}<p>{{.i18n.Tr "repo.hg_oversized"}}</p>
 {{else if not .IsFileText}}<p>{{.i18n.Tr "repo.hg_binary"}}</p>
 {{else if .IsMarkdown}}<div class="markdown">{{.FileContent | Str2html}}</div>
 {{else}}<pre class="prettyprint linenums"><code>{{.FileContent}}</code></pre>{{end}}
 </div>
</div>
