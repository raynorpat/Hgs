<header class="hg-page-header hg-repository-header">
<div>
<p class="hg-breadcrumb">
<a href="{{AppSubUrl}}/{{.Owner.Name}}">{{.Owner.Name}}</a> /</p>
<h1>
<a href="{{.RepoLink}}">{{.Repository.Name}}</a>
</h1>{{if .Repository.IsPrivate}}<span class="hg-badge">{{.i18n.Tr "ui.private"}}</span>{{end}}</div>
<div class="hg-actions" data-repository-controls>
<details class="hg-clone">
<summary class="hg-button hg-button-primary">{{.i18n.Tr "repo.hg_clone"}}</summary>
<div class="hg-clone-panel">
<label for="hg-clone-url">{{.i18n.Tr "ui.clone_command"}}</label>
<div class="hg-actions">{{if not .DisableSSH}}<button class="hg-button" type="button" data-clone-protocol data-clone-url="{{.CloneLink.SSH}}" aria-pressed="false">SSH</button>{{end}}<button class="hg-button" type="button" data-clone-protocol data-clone-url="{{.CloneLink.HTTPS}}" aria-pressed="true">HTTPS</button>
</div>
<input id="hg-clone-url" data-clone-value readonly value="hg clone {{.CloneLink.HTTPS}}">
<button class="hg-button" type="button" data-clone-copy data-copied="{{.i18n.Tr "repo.copied"}}" data-copy-failed="{{.i18n.Tr "ui.copy_failed"}}">{{.i18n.Tr "repo.copy_link"}}</button>
<p role="status" data-clone-status>
</p>
</div>
</details>
{{if .IsSigned}}<a class="hg-button" href="{{.RepoLink}}/fork">{{.i18n.Tr "repo.fork_action"}}</a><form method="post" action="{{.RepoLink}}/action/{{if .IsWatchingRepo}}un{{end}}watch" data-prevent-duplicate>{{.CsrfTokenHtml}}<button type="submit" class="hg-button" aria-pressed="{{if .IsWatchingRepo}}true{{else}}false{{end}}">{{if .IsWatchingRepo}}{{.i18n.Tr "repo.unwatch"}}{{else}}{{.i18n.Tr "repo.watch"}}{{end}} <span>{{.Repository.NumWatches}}</span>
</button>
</form>
<form method="post" action="{{.RepoLink}}/action/{{if .IsStaringRepo}}un{{end}}star" data-prevent-duplicate>{{.CsrfTokenHtml}}<button type="submit" class="hg-button" aria-pressed="{{if .IsStaringRepo}}true{{else}}false{{end}}">{{if .IsStaringRepo}}{{.i18n.Tr "repo.unstar"}}{{else}}{{.i18n.Tr "repo.star"}}{{end}} <span>{{.Repository.NumStars}}</span>
</button>
</form>{{else}}<a class="hg-button" href="{{AppSubUrl}}/user/login">{{.i18n.Tr "ui.sign_in"}} · {{.i18n.Tr "repo.watch"}} / {{.i18n.Tr "repo.star"}}</a>{{end}}
</div>
</header>
<script defer src="{{AppSubUrl}}/js/app/prettify.js">
</script>
<script defer src="{{AppSubUrl}}/js/app/repository.js">
</script>
