<table id="repo-files-table" class="table-border table-block table-radius">
 <thead><tr><th colspan="2"><strong>{{.Changeset.User}}</strong> · <a href="{{.RepoLink}}/commit/{{.Node}}">{{ShortSha .Node}}</a> {{.Changeset.Message}} <span class="age right">{{TimeSince .Changeset.Date .Lang}}</span></th></tr></thead>
 <tbody>
 {{if .ParentURL}}<tr class="has-parent"><td class="icon"></td><td class="name"><a href="{{.ParentURL}}">..</a></td></tr>{{end}}
 {{range .Files}}<tr><td class="icon"><span class="octicon octicon-file-{{if .Directory}}directory{{else}}text{{end}}"></span></td><td class="name"><a href="{{.URL}}" class="text-truncate">{{.Name}}</a>{{if .Symlink}} ↗{{end}}{{if .Executable}} *{{end}}</td></tr>{{end}}
 </tbody>
</table>
{{if .ReadmeExist}}{{template "repo/view_file" .}}{{end}}
