<div id="body-nav" class="repo-nav">
    <div class="container">
        <div class="row">
            <div class="col-md-7">
                <h3 class="name">
<i class="fa fa-book fa-lg">
</i>
<a href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a> / <a href="{{AppSubUrl}}/{{.Owner.Name}}/{{.Repository.Name}}">{{.Repository.Name}}</a> {{if .Repository.IsPrivate}}<span class="label label-default">Private</span>{{end}}</h3>
                <p class="desc">{{.Repository.DescriptionHtml}}{{if .Repository.Website}} <a href="{{.Repository.Website}}">{{.Repository.Website}}</a>{{end}}</p>
            </div>
            <div class="col-md-5 actions text-right clone-group-btn">
                <div id="repo-clone">
<input class="form-control" value="{{.CloneLink.HTTPS}}" readonly />
</div>
                {{if .IsSigned}}
                <form method="post" action="{{.RepoLink}}/action/{{if .IsWatchingRepo}}un{{end}}watch" class="inline">
                    {{.CsrfTokenHtml}}
                    <button class="btn btn-default" type="submit">{{if .IsWatchingRepo}}{{.i18n.Tr "repo.unwatch"}}{{else}}{{.i18n.Tr "repo.watch"}}{{end}} {{.Repository.NumWatches}}</button>
                </form>
                {{end}}
                <!-- <div class="btn-group">
                    <button type="button" class="btn btn-default" data-toggle="tooltip" data-placement="top" title="Star">
<i class="fa fa-star">
</i>&nbsp;{{.Repository.NumStars}}</button>
                </div> -->

            </div>
        </div>
    </div>
</div>
