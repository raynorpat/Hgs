{{template "shared/start" .}}<h1>{{.i18n.Tr "new_repo"}}</h1>
<form class="hg-form" action="{{AppSubUrl}}/repo/create" method="post" data-prevent-duplicate>{{.CsrfTokenHtml}}<div class="hg-field">
<label for="owner">{{.i18n.Tr "repo.owner"}}</label>
<select id="owner" name="uid">
<option value="{{.SignedUser.Id}}"{{if eq .ContextUser.Id .SignedUser.Id}} selected{{end}}>{{.SignedUser.Name}}</option>{{range .Orgs}}<option value="{{.Id}}"{{if eq $.ContextUser.Id .Id}} selected{{end}}>{{.Name}}</option>{{end}}</select>
</div>
<div class="hg-field">
<label for="repo-name">{{.i18n.Tr "repo.repo_name"}}</label>
<input id="repo-name" name="repo_name" value="{{.repo_name}}" required aria-describedby="repo-name-hint"{{if .Err_RepoName}} aria-invalid="true"{{end}}>
<p id="repo-name-hint" class="hg-meta">{{.i18n.Tr "repo.repo_name_helper" | Str2html}}</p>
</div>
<div class="hg-field">
<label for="visibility">
<input id="visibility" name="private" type="checkbox"{{if .private}} checked{{end}}> {{.i18n.Tr "ui.private"}}</label>
<p class="hg-meta">{{.i18n.Tr "repo.visiblity_helper" | Str2html}}</p>
</div>
<div class="hg-field">
<label for="desc">{{.i18n.Tr "repo.repo_desc"}}</label>
<textarea id="desc" name="desc"{{if .Err_Description}} aria-invalid="true"{{end}}>{{.desc}}</textarea>
</div>
<div class="hg-actions">
<button class="hg-button hg-button-primary" type="submit">{{.i18n.Tr "repo.create_repo"}}</button>
<a class="hg-button" href="{{AppSubUrl}}/">{{.i18n.Tr "cancel"}}</a>
</div>
</form>{{template "shared/end" .}}
