<div id="commits-list"><div class="panel panel-radius">
 <div class="panel-header"><h4>{{.i18n.Tr "repo.commits"}} {{.HistoryPath}}</h4></div>
 <table class="panel-body table commit-list table-striped"><thead><tr><th>{{.i18n.Tr "repo.commits.author"}}</th><th>{{.i18n.Tr "repo.hg_changeset"}}</th><th>{{.i18n.Tr "repo.commits.message"}}</th><th>{{.i18n.Tr "repo.commits.date"}}</th></tr></thead>
 <tbody>{{range .Commits}}<tr><td class="author">{{.User}}</td><td class="sha"><a href="{{$.RepoLink}}/commit/{{.Node}}">{{ShortSha (printf "%s" .Node)}}</a></td><td class="message">{{.Message}}</td><td>{{TimeSince .Date $.Lang}}</td></tr>{{end}}</tbody></table>
 </div>{{if .NextHistoryURL}}<a class="btn btn-medium btn-gray btn-radius" href="{{.NextHistoryURL}}" rel="nofollow">{{.i18n.Tr "repo.commits.older"}}</a>{{end}}
</div>
