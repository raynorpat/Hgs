<section>
<h2>{{.i18n.Tr "ui.changesets"}}{{if .HistoryPath}} · {{.HistoryPath}}{{end}}</h2>{{if .Commits}}<div class="hg-scroll" tabindex="0" role="region" aria-label="{{.i18n.Tr "ui.changesets"}}">
<table class="hg-table">
<thead>
<tr>
<th>{{.i18n.Tr "repo.commits.author"}}</th>
<th>{{.i18n.Tr "repo.hg_changeset"}}</th>
<th>{{.i18n.Tr "repo.commits.message"}}</th>
<th>{{.i18n.Tr "repo.commits.date"}}</th>
</tr>
</thead>
<tbody>{{range .Commits}}<tr data-node="{{.Node}}">
<td>{{.User}}</td>
<td>
<a href="{{$.RepoLink}}/commit/{{.Node}}">
<code>{{ShortSha (printf "%s" .Node)}}</code>
</a>
</td>
<td>{{.Message}}</td>
<td class="hg-meta">{{TimeSince .Date $.Lang}}</td>
</tr>{{end}}</tbody>
</table>
</div>{{else}}<p class="hg-empty">{{.i18n.Tr "ui.no_changesets"}}</p>{{end}}{{if .NextHistoryURL}}<nav class="hg-pagination" aria-label="{{.i18n.Tr "ui.changesets"}}">
<a href="{{.NextHistoryURL}}" rel="next nofollow">{{.i18n.Tr "repo.commits.older"}}</a>
</nav>{{end}}</section>
