{{template "shared/start" .}}
{{template "repo/header" .}}
{{if .IssueUIError}}<div role="alert" class="hg-alert hg-alert-danger"{{if .IssueSavedResult}} data-issue-saved-result{{end}}><p>{{.IssueUIError}}</p>{{if .IssueRecoveryHint}}<p>{{.IssueRecoveryHint}}</p>{{end}}{{if .IssueSavedResult}}<a class="hg-button" href="{{.IssueSavedResult}}">{{.i18n.Tr "ui.view_saved_result"}}</a>{{end}}</div>{{end}}
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.issues"}}"><a href="{{.RepoLink}}/issues">{{.i18n.Tr "ui.issues"}}</a><a href="{{.RepoLink}}/issues/milestones">{{.i18n.Tr "ui.milestones"}}</a></nav>
<header class="hg-page-header"><div><h2>{{.Issue.Name}} <span class="hg-meta">#{{.Issue.Index}}</span></h2><p class="hg-meta"><span class="hg-badge {{if .Issue.IsClosed}}hg-status-closed{{else}}hg-status-open{{end}}">{{if .Issue.IsClosed}}{{.i18n.Tr "ui.closed"}}{{else}}{{.i18n.Tr "ui.open"}}{{end}}</span> <a href="{{AppSubUrl}}/{{.Issue.Poster.Name}}">{{.Issue.Poster.Name}}</a> {{.i18n.Tr "ui.opened_issue"}} &middot; {{.Issue.NumComments}} {{.i18n.Tr "ui.comments"}}</p></div><a class="hg-button" href="{{.RepoLink}}/issues/new">{{.i18n.Tr "ui.new_issue"}}</a></header>
<div class="hg-issue-layout"><div>
{{if .IsIssueOwner}}<details class="hg-issue-edit"{{if .EditError}} open{{end}}><summary class="hg-button">{{.i18n.Tr "ui.edit"}}</summary><form action="{{.RepoLink}}/issues/{{.Issue.Index}}" method="post" data-prevent-duplicate data-editor-draft="issue_edit" data-draft-destination="{{.RepoLink}}/issues/{{.Issue.Index}}" data-draft-item="{{.Issue.Id}}" data-draft-title="{{.Issue.Name}}" data-draft-body="{{.Issue.Content}}" autocomplete="off">{{template "shared/editor_draft_controls" .}}{{.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><div class="hg-field"><label for="issue-title">{{.i18n.Tr "ui.title"}}</label><input id="issue-title" name="title" value="{{.EditTitle}}" maxlength="255" required></div>{{template "shared/markdown_editor" .IssueEditor}}<button class="hg-button hg-button-primary" type="submit">{{.i18n.Tr "ui.save"}}</button></form></details>{{end}}
{{template "shared/discussion" .}}
{{if .IsSigned}}<form action="{{.RepoLink}}/comment/new" method="post" enctype="multipart/form-data" data-prevent-duplicate data-editor-draft="issue_comment" data-draft-destination="{{.RepoLink}}/issues/{{.Issue.Index}}" data-draft-item="{{.Issue.Id}}" autocomplete="off">{{template "shared/editor_draft_controls" .}}{{.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><input type="hidden" name="issueIndex" value="{{.Issue.Index}}">
{{template "shared/markdown_editor" .ReplyEditor}}
{{if .AttachmentsEnabled}}<div class="hg-field" data-issue-attachments><label for="attachments">{{.i18n.Tr "ui.attachments"}}</label><input type="file" id="attachments" name="attachments" multiple accept="{{.AllowedTypes}}" data-remove-label="{{.i18n.Tr "ui.remove_attachment"}}"><ul data-attachment-list></ul></div>{{end}}
<div class="hg-actions">{{if .IsIssueOwner}}<button class="hg-button" type="submit" name="change_status" value="{{if .Issue.IsClosed}}Reopen{{else}}Close{{end}}">{{if .Issue.IsClosed}}{{.i18n.Tr "ui.reopen"}}{{else}}{{.i18n.Tr "ui.close"}}{{end}}</button>{{end}}<button type="submit" class="hg-button hg-button-primary">{{.i18n.Tr "ui.comment"}}</button></div></form>{{else}}<a class="hg-button" href="{{AppSubUrl}}/user/login">{{.i18n.Tr "ui.sign_in_comment"}}</a>{{end}}</div>
{{template "shared/issue_metadata" .}}</div>
<script defer src="{{AppSubUrl}}/js/app/issues.js"></script>
{{template "shared/end" .}}
