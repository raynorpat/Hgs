{{template "shared/start" .}}
{{template "repo/header" .}}
{{if .IssueUIError}}<p role="alert" class="hg-alert hg-alert-danger">{{.IssueUIError}}</p>{{end}}
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.issues"}}"><a href="{{.RepoLink}}/issues">{{.i18n.Tr "ui.issues"}}</a><a href="{{.RepoLink}}/issues/milestones">{{.i18n.Tr "ui.milestones"}}</a></nav>
<header class="hg-page-header"><h2>{{.i18n.Tr "ui.issues"}}</h2><a class="hg-button hg-button-primary" href="{{.RepoLink}}/issues/new">{{.i18n.Tr "ui.new_issue"}}</a></header>
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.state"}}"><a href="?type={{.ViewType}}&repoid={{.RepoId}}&labels={{.SelectLabels}}&milestone={{.SelectedMilestone}}&sortType={{.SortType}}"{{if not .IsShowClosed}} aria-current="page"{{end}}>{{.i18n.Tr "ui.open"}} {{.IssueStats.OpenCount}}</a><a href="?type={{.ViewType}}&state=closed&repoid={{.RepoId}}&labels={{.SelectLabels}}&milestone={{.SelectedMilestone}}&sortType={{.SortType}}"{{if .IsShowClosed}} aria-current="page"{{end}}>{{.i18n.Tr "ui.closed"}} {{.IssueStats.ClosedCount}}</a></nav>
<form method="get" class="hg-catalog-filter"><input type="hidden" name="state" value="{{.State}}">
<div class="hg-field"><label for="issue-type">{{.i18n.Tr "ui.issue_filter"}}</label><select id="issue-type" name="type"><option value="all"{{if eq .ViewType "all"}} selected{{end}}>{{.i18n.Tr "ui.all_issues"}} ({{.IssueStats.AllCount}})</option><option value="assigned"{{if eq .ViewType "assigned"}} selected{{end}}>{{.i18n.Tr "ui.assigned_issues"}} ({{.IssueStats.AssignCount}})</option><option value="created_by"{{if eq .ViewType "created_by"}} selected{{end}}>{{.i18n.Tr "ui.created_issues"}} ({{.IssueStats.CreateCount}})</option>{{if .RepoLink}}<option value="mentioned"{{if eq .ViewType "mentioned"}} selected{{end}}>{{.i18n.Tr "ui.mentioned_issues"}} ({{.IssueStats.MentionCount}})</option>{{end}}</select></div>
<div class="hg-field"><label for="issue-label">{{.i18n.Tr "ui.label"}}</label><select id="issue-label" name="labels"><option value="">{{.i18n.Tr "ui.all_labels"}}</option>{{range .Labels}}<option value="{{.Id}}"{{if eq $.SelectLabels (printf "%d" .Id)}} selected{{end}}>{{.Name}}</option>{{end}}</select></div><div class="hg-field"><label for="issue-sort">{{.i18n.Tr "ui.sort"}}</label><select id="issue-sort" name="sortType"><option value="newest">{{.i18n.Tr "ui.newest"}}</option><option value="oldest"{{if eq .SortType "oldest"}} selected{{end}}>{{.i18n.Tr "ui.oldest"}}</option><option value="recentupdate"{{if eq .SortType "recentupdate"}} selected{{end}}>{{.i18n.Tr "ui.recentupdate"}}</option><option value="leastupdate"{{if eq .SortType "leastupdate"}} selected{{end}}>{{.i18n.Tr "ui.leastupdate"}}</option><option value="mostcomment"{{if eq .SortType "mostcomment"}} selected{{end}}>{{.i18n.Tr "ui.mostcomment"}}</option><option value="leastcomment"{{if eq .SortType "leastcomment"}} selected{{end}}>{{.i18n.Tr "ui.leastcomment"}}</option></select></div><input type="hidden" name="milestone" value="{{.SelectedMilestone}}"><button class="hg-button">{{.i18n.Tr "ui.apply_filters"}}</button></form>
<ul class="hg-issue-list">{{range .Issues}}<li id="issue-{{.Id}}"><div><a class="hg-issue-title" href="{{AppSubUrl}}/{{.Repo.Owner.Name}}/{{.Repo.Name}}/issues/{{.Index}}">{{.Name}}</a> <span class="hg-meta">#{{.Index}}</span></div><div class="hg-issue-labels">{{range .Labels}}<span class="hg-label" data-label-color="{{.Color}}">{{.Name}}</span>{{end}}</div><p class="hg-meta hg-issue-row-meta"><a class="hg-inline-person" href="{{AppSubUrl}}/{{.Poster.Name}}"><img src="{{.Poster.AvatarLink}}" width="28" height="28" alt="">{{.Poster.Name}}</a> &middot; <span>{{$.i18n.Tr "ui.last_activity"}} <time datetime="{{.LastActivity.UTC.Format "2006-01-02T15:04:05Z"}}" data-issue-activity>{{TimeSince .LastActivity $.Lang}}</time></span>{{if .Assignee}}<span data-issue-assignee>{{$.i18n.Tr "ui.assignee"}}: <a class="hg-inline-person" href="{{AppSubUrl}}/{{.Assignee.Name}}"><img src="{{.Assignee.AvatarLink}}" width="28" height="28" alt="">{{.Assignee.Name}}</a></span>{{end}}<span>{{.NumComments}} {{$.i18n.Tr "ui.comments"}}</span></p></li>{{else}}<li>{{template "shared/issue_empty" $}}</li>{{end}}</ul>
{{template "shared/pagination" .IssuePagination}}
{{template "repo/issue/labels" .}}
<script defer src="{{AppSubUrl}}/js/app/issues.js"></script>
{{template "shared/end" .}}
