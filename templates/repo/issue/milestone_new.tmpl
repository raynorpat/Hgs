{{template "shared/start" .}}
{{template "repo/header" .}}
{{if .IssueUIError}}<p role="alert" class="hg-alert hg-alert-danger">{{.IssueUIError}}</p>{{end}}
<nav class="hg-tabs" aria-label="{{.i18n.Tr "ui.issues"}}"><a href="{{.RepoLink}}/issues">{{.i18n.Tr "ui.issues"}}</a><a href="{{.RepoLink}}/issues/milestones">{{.i18n.Tr "ui.milestones"}}</a></nav>
<h2>{{.i18n.Tr "ui.new_milestone"}}</h2><form class="hg-form" method="post" action="{{.RepoLink}}/issues/milestones/new" data-prevent-duplicate>{{.CsrfTokenHtml}}<div class="hg-field"><label for="milestone-title">{{.i18n.Tr "ui.title"}}</label><input id="milestone-title" name="title" value="{{.title}}" required maxlength="50"></div>{{template "shared/markdown_editor" .MilestoneEditor}}<div class="hg-field"><label for="milestone-due">{{.i18n.Tr "ui.due_date"}}</label><input id="milestone-due" name="due_date" type="date" value="{{.due_date}}"><p class="hg-meta">{{.i18n.Tr "ui.due_date_hint"}}</p></div><button class="hg-button hg-button-primary" type="submit">{{.i18n.Tr "ui.create_milestone"}}</button></form><script defer src="{{AppSubUrl}}/js/app/issues.js"></script>
{{template "shared/end" .}}
