{{if .IsRepositoryOwner}}<details class="hg-panel hg-label-manager"><summary>{{.i18n.Tr "ui.manage_labels"}}</summary>
{{range .Labels}}<div class="hg-label-management"><form action="{{$.RepoLink}}/issues/labels/edit" method="post" class="hg-catalog-filter" data-prevent-duplicate>{{$.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><input type="hidden" name="id" value="{{.Id}}"><div class="hg-field"><label for="label-{{.Id}}-name">{{$.i18n.Tr "ui.label"}}</label><input id="label-{{.Id}}-name" name="title" value="{{.Name}}" required maxlength="50"></div><div class="hg-field"><label for="label-{{.Id}}-color">{{$.i18n.Tr "ui.color"}}</label><input id="label-{{.Id}}-color" type="color" name="color" value="{{.Color}}" required></div><button class="hg-button" type="submit">{{$.i18n.Tr "ui.save"}}</button></form><form method="post" action="{{$.RepoLink}}/issues/labels/delete" data-prevent-duplicate>{{$.CsrfTokenHtml}}<input type="hidden" name="ui" value="1"><input type="hidden" name="remove" value="{{.Id}}"><button class="hg-button hg-button-danger" type="submit">{{$.i18n.Tr "ui.delete"}} {{.Name}}</button></form></div>{{end}}
<form action="{{.RepoLink}}/issues/labels/new" method="post" class="hg-catalog-filter" data-prevent-duplicate>{{.CsrfTokenHtml}}<div class="hg-field"><label for="label-name">{{.i18n.Tr "ui.new_label"}}</label><input id="label-name" name="title" value="{{.title}}" required maxlength="50"></div><div class="hg-field"><label for="label-color">{{.i18n.Tr "ui.color"}}</label><input type="color" id="label-color" name="color" value="#0052cc" required></div><button class="hg-button" type="submit">{{.i18n.Tr "ui.create"}}</button></form></details>{{end}}
