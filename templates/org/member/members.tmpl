{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div class="">
    <div class="org-header-alert">

    </div>
    <div class="org-toolbar">
        {{if .IsOrganizationOwner}}
        <a class="hg-button hg-button-primary " href="{{.OrgLink}}/invitations/new"> {{.i18n.Tr "org.invite_someone"}}</a>
        {{end}}
    </div>
    <div id="org-member-list">
        {{range .Members}}
        <div class="org-member-item">
            {{template "shared/avatar" (Avatar .AvatarLink .Name 40)}}
            <a class="text-black" href="{{AppSubUrl}}/{{.Name}}"><span class="member-name"><strong>{{.FullName}}</strong>({{.Name}})</span></a>
            <ul class="grid-6-12">
                <li class="grid-1-3">
                {{ $isPublic := .IsPublicMember $.Org.Id}}
                {{if $isPublic}}
                    {{$.i18n.Tr "org.members.public"}}
                    {{if eq $.SignedUser.Id .Id}}(<form class="hg-inline-form" method="post" action="{{$.OrgLink}}/members/action/private?uid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.members.public_helper"}}</button></form>){{end}}
                {{else}}
                    {{$.i18n.Tr "org.members.private"}}
                    {{if eq $.SignedUser.Id .Id}}(<form class="hg-inline-form" method="post" action="{{$.OrgLink}}/members/action/public?uid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.members.private_helper"}}</button></form>){{end}}
                {{end}}
                </li>
                <li class="grid-1-4">{{if .IsUserOrgOwner $.Org.Id}}<strong>{{$.i18n.Tr "org.members.owner"}}</strong>{{else}}{{$.i18n.Tr "org.members.member"}}{{end}}</li>
                {{if eq $.SignedUser.Id .Id}}
                    <li class="grid-1-6">
                        <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/members/action/leave?uid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.members.leave"}}</button></form>
                    </li>
                {{else if $.IsOrganizationOwner}}
                    <li class="grid-1-6">
                        <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/members/action/remove?uid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.members.remove"}}</button></form>
                    </li>
                    {{if $isPublic}}
                        <li class="grid-1-6">
                            <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/members/action/private?uid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.members.conceal"}}</button></form>
                        </li>
                    {{end}}
                {{end}}
            </ul>
        </div>
        {{end}}
    </div>
</div>
</div>
{{template "shared/end" .}}
