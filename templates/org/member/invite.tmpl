{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div class="">
    <div class="invite-box" id="invite-box">

        <h3>{{.i18n.Tr "org.members.invite_desc" .Org.FullName}}</h3>
        <form id="invite-member-form" action="{{.OrgLink}}/invitations/new" method="post" data-prevent-duplicate>
            {{.CsrfTokenHtml}}
            <label for="org-member-invite">{{.i18n.Tr "username"}}</label><input class="" id="org-member-invite" list="org-member-invite-results" data-account-search="{{AppSubUrl}}/api/v1/users/search" name="uname" autocomplete="off" required>
            <button class="hg-button hg-button-primary">{{.i18n.Tr "org.members.invite_now"}}</button>
            <div id="org-member-list-block">
                <ul class="menu-down-show hg-settings-nav menu-radius switching-list user-list" id="org-member-invite-list"></ul>
            </div>
        <datalist id="org-member-invite-results"></datalist></form>
    </div>
</div>
</div>
{{template "shared/end" .}}
