{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div id="setting-wrapper" class="">
    <div id="org-setting" class="">
        {{template "org/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="setting-content">
                    <div id="user-profile-setting-content" class="hg-panel">
                        <div class="hg-panel-heading">
                            <strong>{{.i18n.Tr "org.settings.options"}}</strong>
                        </div>
                        <form class="hg-form hg-panel-body" id="org-setting-form" action="{{AppSubUrl}}/org/{{.Org.LowerName}}/settings" method="post" data-rename-field="uname" data-original-name="{{.Org.Name}}" data-confirm-message="{{.i18n.Tr "org.settings.change_orgname_desc"}}" data-prevent-duplicate>
                            {{.CsrfTokenHtml}}
                            <input type="hidden" name="action" value="update">
                            <div class="hg-field">
                                <label class="req" for="orgname">{{.i18n.Tr "username"}}</label>
                                <input  id="orgname" name="uname" value="{{if .HasError}}{{.uname}}{{else}}{{.Org.Name}}{{end}}" data-orgname="{{.Org.Name}}" required  {{if .Err_OrgUserName}}aria-invalid="true" aria-describedby="orgname-error"{{end}}>{{if .Err_OrgUserName}}<span class="hg-field-error" id="orgname-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </div>

                            <div class="hg-field">
                                <label for="full-name">{{.i18n.Tr "org.settings.full_name"}}</label>
                                <input  id="full-name" name="fullname" value="{{if .HasError}}{{.fullname}}{{else}}{{.Org.FullName}}{{end}}"  {{if .Err_OrgFullName}}aria-invalid="true" aria-describedby="full-name-error"{{end}}>{{if .Err_OrgFullName}}<span class="hg-field-error" id="full-name-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </div>
                            <div class="hg-field">
                                <label class="req" for="email">{{.i18n.Tr "email"}}</label>
                                <input  id="email" name="email" type="email" value="{{if .HasError}}{{.email}}{{else}}{{.Org.Email}}{{end}}" required  {{if .Err_Email}}aria-invalid="true" aria-describedby="email-error"{{end}}>{{if .Err_Email}}<span class="hg-field-error" id="email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </div>
                            <div class="hg-field">
                                <label class="" for="desc">{{.i18n.Tr "org.org_desc"}}</label>
                                <textarea  id="desc" name="desc" {{if .Err_Description}}aria-invalid="true"{{end}}>{{if .HasError}}{{.desc}}{{else}}{{.Org.Description}}{{end}}</textarea>
                            </div>
                            <div class="hg-field">
                                <label for="website">{{.i18n.Tr "org.settings.website"}}</label>
                                <input  id="website" name="website" type="url" value="{{if .HasError}}{{.website}}{{else}}{{.Org.Website}}{{end}}"  {{if .Err_Website}}aria-invalid="true" aria-describedby="website-error"{{end}}>{{if .Err_Website}}<span class="hg-field-error" id="website-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </div>
                            <div class="hg-field">
                                <label for="location">{{.i18n.Tr "org.settings.location"}}</label>
                                <input  id="location" name="location" type="text" value="{{if .HasError}}{{.location}}{{else}}{{.Org.Location}}{{end}}"  {{if .Err_Location}}aria-invalid="true" aria-describedby="location-error"{{end}}>{{if .Err_Location}}<span class="hg-field-error" id="location-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </div>
                            <div class="hg-field">
                                <label for="gravatar-email">Gravatar {{.i18n.Tr "email"}}</label>
                                <input  id="gravatar-email" name="avatar" type="text" value="{{if .HasError}}{{.avatar}}{{else}}{{.Org.AvatarEmail}}{{end}}"  {{if .Err_Avatar}}aria-invalid="true" aria-describedby="gravatar-email-error"{{end}}>{{if .Err_Avatar}}<span class="hg-field-error" id="gravatar-email-error">{{.Flash.ErrorMsg}}</span>{{end}}
                            </div>
                            <div class="hg-field">
                                <span class="form-label"></span>
                                <button class="hg-button hg-button-primary" id="change-orgname-btn">{{.i18n.Tr "org.settings.update_settings"}}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
