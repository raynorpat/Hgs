{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div id="setting-wrapper" class="">
    <div id="org-setting" class="">
        {{template "org/settings/nav" .}}
        <div class="">
            <div class="setting-content">

                <div id="setting-content">
                    <div id="user-profile-setting-content" class="hg-panel panel-warning">
                        <p class="hg-panel-heading"><strong>{{.i18n.Tr "org.settings.delete_account"}}</strong></p>
                        <div class="hg-panel-body">
                            <span class="hg-alert hg-alert-danger">{{.i18n.Tr "org.settings.delete_prompt" | Str2html}}</span>
                            <form id="delete-org-form" action="{{AppSubUrl}}/org/{{.Org.LowerName}}/settings/delete" method="post" data-confirm-message="{{.i18n.Tr "org.settings.delete_org_desc"}}" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <p class="hg-field">
                                    <span class="form-label"></span>
                                    <button class="hg-button hg-button-danger" id="delete-org-btn">{{.i18n.Tr "org.settings.confirm_delete_account"}}</button>
                                </p>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
