<div class="org-header" id="org-header">
    <div class="">
        <a class="text-black" href="{{AppSubUrl}}/org/{{.Org.LowerName}}">
            <img class="avatar-48" alt="{{.Org.Name}}" src="{{.Org.AvatarLink}}" data-avatar-fallback="{{AppSubUrl}}/img/avatar_default.jpg">
            <span class="org-name">{{.Org.FullName}}</span>
        </a>
        <ul class="menu hg-tabs">
            <li class="">
                <a {{if .PageIsOrgTeams}}class="current"{{end}} href="{{.OrgLink}}/teams"> {{.i18n.Tr "org.teams"}} <span class="label label-gray label-radius">{{.Org.NumTeams}}</span></a>
            </li>
            <li class="">
                <a {{if .PageIsOrgMembers}}class="current"{{end}} href="{{.OrgLink}}/members"> {{.i18n.Tr "org.people"}} <span class="label label-gray label-radius">{{.Org.NumMembers}}</span></a>
            </li>
        </ul>
    </div>
</div>
