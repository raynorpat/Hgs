{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div id="setting-wrapper" class="">
    <div id="team-members-list" class="">

        {{template "org/team/sidebar" .}}
        <div class="">
            <div class="setting-content">
                <div class="hg-panel">
                    <div class="hg-panel-heading">
                        {{.i18n.Tr "org.teams.repositories"}}
                    </div>
                    {{$canAddRemove := and $.IsOrganizationOwner (not (eq $.Team.LowerName "owners"))}}
                    <ul class="hg-panel-body hg-account-list" id="team-repositories-list">
                        {{if $canAddRemove}}
                        <li class="search">
                            <form class="hg-form" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/repo/add" id="repo-collab-form" method="post" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <label for="org-team-repositories-add">{{.i18n.Tr "repo.repo_name"}}</label><input class="" id="org-team-repositories-add" list="org-team-repositories-add-results" data-account-search="{{AppSubUrl}}/api/v1/repos/search" data-owner="{{.Org.Id}}" name="repo-name" autocomplete="off" data-uid="{{.Org.Id}}" required />
                                <button class="hg-button hg-button-primary">{{.i18n.Tr "org.teams.add_team_repository"}}</button>
                                <div class="repo-user-list-block">
                                    <ul class="menu-down-show hg-settings-nav menu-radius switching-list user-list" id="org-team-repositories-list"></ul>
                                </div>
                            <datalist id="org-team-repositories-add-results"></datalist></form>
                        </li>
                        {{end}}
                        {{range .Team.Repos}}
                        <li class="collab">
                            {{if $canAddRemove}}
                            <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/repo/remove?repoid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.teams.remove_repo"}}</button></form>
                            {{end}}
                            <a class="member" href="{{AppSubUrl}}/{{$.Org.Name}}/{{.Name}}">

                                <strong>{{$.Org.Name}}/{{.Name}}</strong>
                            </a>
                        </li>
                        {{end}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
