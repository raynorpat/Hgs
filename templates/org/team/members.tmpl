{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div id="setting-wrapper" class="">
    <div id="team-members-list" class="">

        {{template "org/team/sidebar" .}}
        <div class="">
            <div class="setting-content">
                <div class="hg-panel">
                    <div class="hg-panel-heading">
                        {{.i18n.Tr "org.teams.members"}}
                    </div>
                    <ul class="hg-panel-body hg-account-list" id="team-members-list">
                        {{if .IsOrganizationOwner}}
                        <li class="search">
                            <form class="hg-form" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/add" id="repo-collab-form" method="post" data-prevent-duplicate>
                                {{.CsrfTokenHtml}}
                                <input type="hidden" name="uid" value="{{.SignedUser.Id}}">
                                <label for="org-team-members-add">{{.i18n.Tr "username"}}</label><input class="" id="org-team-members-add" list="org-team-members-add-results" data-account-search="{{AppSubUrl}}/api/v1/users/search" name="uname" autocomplete="off" required />
                                <button class="hg-button hg-button-primary">{{.i18n.Tr "org.teams.add_team_member"}}</button>
                                <div class="repo-user-list-block">
                                    <ul class="menu-down-show hg-settings-nav menu-radius switching-list user-list" id="org-team-members-list"></ul>
                                </div>
                            <datalist id="org-team-members-add-results"></datalist></form>
                        </li>
                        {{end}}
                        {{range .Team.Members}}
                        <li class="collab">
                            {{if $.IsOrganizationOwner}}
                            <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/remove?uid={{.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.members.remove"}}</button></form>
                            {{end}}
                            <a class="member" href="{{AppSubUrl}}/{{.Name}}">
                                <img alt="{{.Name}}" class="pull-left avatar" src="{{.AvatarLink}}" data-avatar-fallback="{{AppSubUrl}}/img/avatar_default.jpg">
                                <strong>{{.FullName}}</strong> ({{.Name}})
                            </a>
                        </li>
                        {{end}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{{template "shared/end" .}}
