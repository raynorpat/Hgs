{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div class="">
    <div class="org-header-alert">

    </div>
    <div class="org-toolbar">
        {{if .IsOrganizationOwner}}
        <a class="hg-button hg-button-primary " href="{{.OrgLink}}/teams/new"> {{.i18n.Tr "org.create_new_team"}}</a>
        {{end}}
    </div>
    <div class="org-team-list">
        {{range .Teams}}
        <div class="org-team-list-item">
            <div class="hg-panel">
                <div class="hg-panel-heading">
                    {{if .IsMember $.SignedUser.Id}}
                    <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/teams/{{.LowerName}}/action/leave?uid={{$.SignedUser.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.teams.leave"}}</button></form>
                    {{else if $.IsOrganizationOwner}}
                    <form class="hg-inline-form" method="post" action="{{$.OrgLink}}/teams/{{.LowerName}}/action/join?uid={{$.SignedUser.Id}}" data-confirm-message="{{$.i18n.Tr "ui.confirm_action"}}">{{$.CsrfTokenHtml}}<button type="submit" class="hg-button">{{$.i18n.Tr "org.teams.join"}}</button></form>
                    {{end}}
                    <a class="text-black" href="{{$.OrgLink}}/teams/{{.LowerName}}"><strong>{{.Name}}</strong></a>
                </div>
                {{if .NumMembers}}
                <div class="hg-panel-body member-avatar-group">
                    {{range .Members}}
                    <a href="{{AppSubUrl}}/{{.Name}}" title="{{.Name}}">
                        <img alt="{{.Name}}" width="40" height="40" src="{{.AvatarLink}}" data-avatar-fallback="{{AppSubUrl}}/img/avatar_default.jpg">
                    </a>
                    {{end}}
                </div>
                {{end}}
                <div class="panel-footer">
                    <p class="team-meta">{{.NumMembers}} {{$.i18n.Tr "org.lower_members"}} · {{.NumRepos}} {{$.i18n.Tr "org.lower_repositories"}}</p>
                </div>
            </div>
        </div>
        {{end}}
    </div>
</div>
</div>
{{template "shared/end" .}}
