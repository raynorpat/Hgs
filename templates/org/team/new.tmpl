{{template "shared/start" .}}
<div class="hg-account-page">

{{template "org/base/header" .}}
<div id="repo-wrapper">
    <form id="team-create-form" class="hg-form hg-panel" action="{{if .PageIsOrgTeamsNew}}{{.OrgLink}}/teams/new{{else}}{{.OrgLink}}/teams/{{.Team.LowerName}}/edit{{end}}" method="post" data-prevent-duplicate>
        {{.CsrfTokenHtml}}
        <div class="hg-panel-heading">
            <h2>
                {{if .PageIsOrgTeamsNew}}{{.i18n.Tr "org.create_new_team"}}{{else}}{{.i18n.Tr "org.teams.settings"}}{{end}}
            </h2>
        </div>
        <div class="hg-panel-body">

            <div class="hg-field">
                <label class="req" for="team-name">{{.i18n.Tr "org.team_name"}}</label>
                {{if eq .Team.LowerName "owners"}}
                <input type="hidden" name="team_name" value="{{.team_name}}">
                {{end}}
                <input  id="team-name" name="team_name" value="{{.team_name}}" required {{if eq .Team.LowerName "owners"}}disabled{{end}}  {{if .Err_TeamName}}aria-invalid="true" aria-describedby="team-name-error"{{end}}>{{if .Err_TeamName}}<span class="hg-field-error" id="team-name-error">{{.Flash.ErrorMsg}}</span>{{end}}
                <span class="form-label"></span>
                <span class="hg-meta">{{.i18n.Tr "org.team_name_helper"}}</span>
            </div>
            <div class="hg-field">
                <label for="desc">{{.i18n.Tr "org.team_desc"}}</label>
                <input  id="desc" name="desc" value="{{.desc}}"  {{if .Err_Description}}aria-invalid="true" aria-describedby="desc-error"{{end}}>{{if .Err_Description}}<span class="hg-field-error" id="desc-error">{{.Flash.ErrorMsg}}</span>{{end}}
                <span class="form-label"></span>
                <span class="hg-meta">{{.i18n.Tr "org.team_desc_helper"}}</span>
            </div>
            {{if not (eq .Team.LowerName "owners")}}
            <div class="hg-field">
                <h4 class="text-center">{{.i18n.Tr "org.team_permission_desc"}}</h4>
                <label class="hg-choice"><input name="permission" type="radio" value="read" {{if or .PageIsOrgTeamsNew (eq .Team.Authorize 1)}}checked{{end}}> {{.i18n.Tr "org.teams.read_access"}}</label>
                <p class="text-grey note">{{.i18n.Tr "org.teams.read_access_helper"}}</p>
                <label class="hg-choice"><input name="permission" type="radio" value="write" {{if eq .Team.Authorize 2}}checked{{end}}> {{.i18n.Tr "org.teams.write_access"}}</label>
                <p class="text-grey note">{{.i18n.Tr "org.teams.write_access_helper"}}</p>
                <label class="hg-choice"><input name="permission" type="radio" value="admin" {{if eq .Team.Authorize 3}}checked{{end}}> {{.i18n.Tr "org.teams.admin_access"}}</label>
                <p class="text-grey note">{{.i18n.Tr "org.teams.admin_access_helper"}}</p>
            </div>
            <hr>
            {{end}}
            <div class="hg-field">
                {{if .PageIsOrgTeamsNew}}
                    <button class="hg-button hg-button-primary">{{.i18n.Tr "org.create_new_team"}}</button>
                    <a class="hg-button " id="repo-create-cancel" href="{{.OrgLink}}/teams"><strong>{{.i18n.Tr "cancel"}}</strong></a>
                {{else}}
                    <button class="hg-button hg-button-primary">{{.i18n.Tr "org.teams.update_settings"}}</button>
                    {{if not (eq .Team.LowerName "owners")}}
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <button class="hg-button hg-button-danger" id="org-team-delete" type="submit" formnovalidate formaction="{{.OrgLink}}/teams/{{.Team.LowerName}}/delete" data-confirm-message="{{.i18n.Tr "ui.confirm_action"}}">{{.i18n.Tr "org.teams.delete_team"}}</button>

                    {{end}}
                {{end}}
            </div>
        </div>
    </form>
</div>
</div>
{{template "shared/end" .}}
